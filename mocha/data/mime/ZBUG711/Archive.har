\" \\u306b\\u8a2d\\u5b9a\\u3059\\u308b\\u3068\\u3001\\u6b21\\u56de\\u30b5\\u30fc\\u30d3\\u30b9\\u3092\\u8d77\\u52d5/\\u518d\\u8d77\\u52d5\\u3059\\u308b\\u3068\\u304d\\u3001\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u306e\\u5168\\u6a5f\\u80fd\\u306f\\u5229\\u7528\\u3067\\u304d\\u306a\\u304f\\u306a\\u308a\\u307e\\u3059\\u3002\";\na.ZxAdmin_AdminLogPath=\"\\u30ed\\u30b0\\u30d6\\u30e9\\u30a6\\u30b6\\u53ca\\u3073\\u6708\\u9593\\u30ec\\u30dd\\u30fc\\u30c8\\u6a5f\\u80fd\\u306b\\u5fc5\\u8981\\u306a\\u30ed\\u30b0\\u3092 Admin\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u306b\\u4fdd\\u5b58\\u3055\\u305b\\u308b\\u304b\\u3069\\u3046\\u304b\\u306e\\u8a2d\\u5b9a\\u3002\";\na.ZxAdmin_AdminLogEnabled=\"Admin\\u7528\\u306e\\u30ed\\u30ae\\u30f3\\u30b0\\u30b7\\u30b9\\u30c6\\u30e0\\u3092\\u5229\\u7528\\u3059\\u308b\\u304b\\u3069\\u3046\\u304b\\u306e\\u8a2d\\u5b9a\\u3002\\\"false\\\"\\u306b\\u8a2d\\u5b9a\\u3059\\u308b\\u3068\\u3001\\\"\\u30ed\\u30b0\\u95b2\\u89a7\\\" \\u53ca\\u3073 \\\"\\u6708\\u9593\\u30ec\\u30dd\\u30fc\\u30c8\\\" \\u6a5f\\u80fd\\u306b\\u95a2\\u3059\\u308b\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u304c\\u5f71\\u97ff\\u3092\\u3046\\u3051\\u307e\\u3059\\u3002\";\na.ZxBackup_ModuleEnabledAtStartup=\"Backup \\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u3092\\u5229\\u7528\\u3059\\u308b\\u304b\\u306e\\u8a2d\\u5b9a\\u3002Backup \\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u3092\\u7121\\u52b9\\u306b\\u3059\\u308b\\u3068\\u3001\\u3059\\u3079\\u3066\\u306e\\u30d0\\u30c3\\u30af\\u30a2\\u30c3\\u30d7\\u30fb\\u30ea\\u30b9\\u30c8\\u30a2\\u6a5f\\u80fd\\u304c\\u7121\\u52b9\\u306b\\u306a\\u308a\\u307e\\u3059\\u3002\";\na.ZxBackup_SpaceThreshold=\"Backup \\u306e\\u30d0\\u30c3\\u30af\\u30a2\\u30c3\\u30d7\\u30d1\\u30b9\\u3092\\u8a2d\\u5b9a\\u3059\\u308b\\u30c7\\u30d0\\u30a4\\u30b9/\\u30d1\\u30fc\\u30c6\\u30a3\\u30b7\\u30e7\\u30f3\\u306e\\u6700\\u4f4e\\u7a7a\\u304d\\u5bb9\\u91cf\\u3002<br>\\u5bb9\\u91cf\\u304c\\u95be\\u5024\\u3092\\u4e0b\\u56de\\u3063\\u305f\\u5834\\u5408\\u3001Backup \\u306f\\u30c7\\u30d0\\u30a4\\u30b9\\u3078\\u306e\\u66f8\\u304d\\u8fbc\\u307f\\u3092\\u4e2d\\u6b62\\u3057\\u307e\\u3059\\u3002<br>\\u901a\\u77e5\\u304c\\u9001\\u3089\\u308c\\u3001\\u30b9\\u30c8\\u30ec\\u30fc\\u30b8\\u306e\\u7a7a\\u304d\\u5bb9\\u91cf\\u304c\\u5341\\u5206\\u306b\\u306a\\u308b\\u307e\\u3067\\u30d0\\u30c3\\u30af\\u30a2\\u30c3\\u30d7\\u51e6\\u7406\\u306f\\u30ad\\u30e5\\u30fc\\u306b\\u6ede\\u7559\\u3057\\u307e\\u3059\\u3002\";\na.ZxBackup_DestPath=\"\\u3059\\u3079\\u3066\\u306e\\u30d0\\u30c3\\u30af\\u30a2\\u30c3\\u30d7\\u30c7\\u30fc\\u30bf\\u3092\\u683c\\u7d0d\\u3055\\u308c\\u308b\\u30d1\\u30b9\\u3002<br>\\u3053\\u306e\\u30d1\\u30b9\\u306b\\u306f\\u30d0\\u30c3\\u30af\\u30a2\\u30c3\\u30d7\\u60c5\\u5831\\u304c\\u683c\\u7d0d\\u3055\\u308c\\u307e\\u3059; \\u30a2\\u30a4\\u30c6\\u30e0\\u3001\\u30e1\\u30bf\\u30c7\\u30fc\\u30bf\\u3001\\u30b5\\u30fc\\u30d0\\u8a2d\\u5b9a\\u3001\\u30ab\\u30b9\\u30bf\\u30de\\u30a4\\u30ba\\u60c5\\u5831\\u3001\\u53ca\\u3073\\u91cd\\u8981\\u306a\\u30de\\u30c3\\u30d7\\u30d5\\u30a1\\u30a4\\u30eb\\u3068\\u30b5\\u30fc\\u30d0\\u306e\\u30ed\\u30c3\\u30af\\u30d5\\u30a1\\u30a4\\u30eb <br>\\u30d1\\u30b9\\u304c\\u5b58\\u5728\\u3057\\u3001\\u304b\\u3064 \\\"zimbra\\\" \\u30e6\\u30fc\\u30b6\\u306b\\u66f8\\u304d\\u8fbc\\u307f/\\u8aad\\u307f\\u8fbc\\u307f\\u6a29\\u9650\\u304c\\u4ed8\\u4e0e\\u3055\\u308c\\u3066\\u3044\\u308b\\u5fc5\\u8981\\u304c\\u3042\\u308a\\u307e\\u3059\\u3002\";\na.ZxChat_LogEnabled=\"\\u30c1\\u30e3\\u30c3\\u30c8\\u30e1\\u30c3\\u30bb\\u30fc\\u30b8\\u3068\\u60c5\\u5831\\u306e\\u30ed\\u30b0\\u3060\\u3051\\u3092\\u5c02\\u9580\\u306b\\u51fa\\u529b\\u3059\\u308b\\u30ed\\u30b0\\u30d5\\u30a1\\u30a4\\u30eb\\u3092\\u4f7f\\u7528\\u3059\\u308b/\\u4f7f\\u7528\\u3057\\u306a\\u3044\\u8a2d\\u5b9a\\u3002<br>\\u30ed\\u30b0\\u30d5\\u30a1\\u30a4\\u30eb\\u306f /opt/zimbra/log/zxchat.log \\u306b\\u7f6e\\u304b\\u308c\\u307e\\u3059\\u3002\";\na.ZxChat_ModuleEnabledAtStartup=\"Zimbra mailboxd \\u30b5\\u30fc\\u30d3\\u30b9\\u8d77\\u52d5\\u6642\\u306b\\u3001\\u81ea\\u52d5\\u7684\\u306b\\u30c1\\u30e3\\u30c3\\u30c8\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u3082\\u8d77\\u52d5\\u3055\\u305b\\u308b/\\u8d77\\u52d5\\u3055\\u305b\\u306a\\u3044\\u8a2d\\u5b9a\\u3002\\\"false\\\" \\u306b\\u8a2d\\u5b9a\\u3059\\u308b\\u3068\\u3001\\u6b21\\u306b\\u30b5\\u30fc\\u30d3\\u30b9\\u304c\\u8d77\\u52d5/\\u518d\\u8d77\\u52d5\\u3057\\u305f\\u6642\\u3001\\u3059\\u3079\\u3066\\u306e\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u6a5f\\u80fd\\u306f\\u5229\\u7528\\u3067\\u304d\\u306a\\u304f\\u306a\\u308a\\u307e\\u3059\\u3002\";\na.ZxMobile_ModuleEnabledAtStartup=\"\\u30e2\\u30d0\\u30a4\\u30eb\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u3092\\u5229\\u7528\\u3059\\u308b\\u304b\\u306e\\u8a2d\\u5b9a\\u3002<br>\\u5229\\u7528\\u3057\\u306a\\u3044\\u5834\\u5408\\u3001\\u3059\\u3079\\u3066\\u306e\\u30e2\\u30d0\\u30a4\\u30eb\\u540c\\u671f\\u6a5f\\u80fd\\u306f\\u5229\\u7528\\u3067\\u304d\\u306a\\u304f\\u306a\\u308a\\u307e\\u3059\\u3002\";\na.MSG_BCK_INTRO_Restore_wizard_undelete=\"\\u3053\\u306e\\u30a6\\u30a3\\u30b6\\u30fc\\u30c9\\u306f\\u3001\\u6307\\u5b9a\\u3055\\u308c\\u305f\\u30e1\\u30fc\\u30eb\\u30dc\\u30c3\\u30af\\u30b9\\u306b\\u95a2\\u3057\\u3066\\u3001\\u6307\\u5b9a\\u3055\\u308c\\u305f\\u671f\\u9593\\u5185\\u306b\\u524a\\u9664\\u3055\\u308c\\u305f\\u3059\\u3079\\u3066\\u306e\\u30a2\\u30a4\\u30c6\\u30e0\\u3092\\u5fa9\\u5143\\u3059\\u308b\\u4f5c\\u696d\\u306e\\u624b\\u9806\\u3092\\u793a\\u3057\\u307e\\u3059\\u3002\\u5fa9\\u5143\\u3055\\u308c\\u305f\\u30a2\\u30a4\\u30c6\\u30e0\\u306f\\u3001\\u5c02\\u7528\\u306e\\u30d5\\u30a9\\u30eb\\u30c0 - \\u30d5\\u30a1\\u30a4\\u30eb\\u540d \\\"\\u524a\\u9664\\u53d6\\u308a\\u6d88\\u3057\\\" (\\u30ea\\u30b9\\u30c8\\u30a2\\u5b9f\\u65bd\\u6642\\u9593\\u304c\\u4ed8\\u8a18) - \\u306b\\u623b\\u3055\\u308c\\u307e\\u3059\\u3002<br><br><b>\\u6ce8\\u610f\\u4e8b\\u9805</b><ul><li>\\\"\\u958b\\u59cb\\u65e5\\u6642\\\" \\u3068 \\\"\\u7d42\\u4e86\\u65e5\\u6642\\\" \\u30d5\\u30a3\\u30fc\\u30eb\\u30c9\\u306b\\u306f\\u3001\\u5fa9\\u5143\\u3092\\u5e0c\\u671b\\u3059\\u308b\\u958b\\u59cb\\u65e5\\u304a\\u3088\\u3073\\u7d42\\u4e86\\u65e5\\u3092\\u6307\\u5b9a\\u3057\\u3066\\u304f\\u3060\\u3055\\u3044\\u3002\\u3053\\u306e\\u671f\\u9593\\u306e\\u9593\\u306b\\u524a\\u9664\\u3055\\u308c\\u305f\\u30a2\\u30a4\\u30c6\\u30e0\\u304c\\u3059\\u3079\\u3066\\u5fa9\\u5143\\u3055\\u308c\\u307e\\u3059\\u3002</li><ul><li>\\\"\\u958b\\u59cb\\u65e5\\u6642\\\" \\u8a2d\\u5b9a\\u306e\\u3068\\u3053\\u308d\\u3067\\u3001\\\"\\u4e00\\u756a\\u53e4\\u3044\\u30c7\\u30fc\\u30bf\\u3092\\u4f7f\\u7528\\\" \\u3092\\u9078\\u629e\\u3059\\u308b\\u3068\\u3001\\u7d42\\u4e86\\u65e5\\u6642\\u3088\\u308a\\u524d\\u306e\\u6642\\u70b9\\u3067\\u304b\\u3064\\u30d0\\u30c3\\u30af\\u30a2\\u30c3\\u30d7\\u4fdd\\u6301\\u671f\\u9593\\u5185\\u306b\\u304a\\u3044\\u3066\\u3001\\u4e00\\u756a\\u53e4\\u3044\\u6642\\u523b\\u306b\\u524a\\u9664\\u3055\\u308c\\u305f\\u30a2\\u30a4\\u30c6\\u30e0\\u304c\\u5fa9\\u5143\\u3055\\u308c\\u307e\\u3059\\u3002</li><li>\\\"\\u7d42\\u4e86\\u65e5\\u6642\\\" \\u8a2d\\u5b9a\\u306e\\u3068\\u3053\\u308d\\u3067\\u3001\\\"\\u4e00\\u756a\\u65b0\\u3057\\u3044\\u30c7\\u30fc\\u30bf\\u3092\\u4f7f\\u7528\\\" \\u3092\\u9078\\u629e\\u3059\\u308b\\u3068\\u3001\\u30d0\\u30c3\\u30af\\u30a2\\u30c3\\u30d7\\u4fdd\\u6301\\u671f\\u9593\\u5185\\u3067\\u3001\\u4e00\\u756a\\u6700\\u8fd1\\u306b\\u524a\\u9664\\u3055\\u308c\\u305f\\u30a2\\u30a4\\u30c6\\u30e0\\u304c\\u5fa9\\u5143\\u3055\\u308c\\u307e\\u3059\\u3002</li></ul><li>\\u30b4\\u30df\\u7bb1\\u30d5\\u30a9\\u30eb\\u30c0\\u306b\\u79fb\\u52d5\\u3057\\u305f\\u30a2\\u30a4\\u30c6\\u30e0\\u3084\\u3001IMAP \\u3067\\u6d88\\u53bb\\u3055\\u308c\\u3066\\u3044\\u308b\\u304c (DELETED \\u30d5\\u30e9\\u30b0\\u304c\\u4ed8\\u3051\\u3089\\u308c\\u3066\\u3044\\u308b\\u304c)\\u3001\\u307e\\u3060\\u30d1\\u30fc\\u30b8\\u3055\\u308c\\u3066\\u3044\\u306a\\u3044\\u30a2\\u30a4\\u30c6\\u30e0\\u306f\\u3001\\\"\\u524a\\u9664\\u6e08\\u307f\\\" \\u6271\\u3044\\u306b\\u306f\\u306a\\u3089\\u306a\\u3044\\u305f\\u3081\\u5fa9\\u5143\\u306f\\u3055\\u308c\\u307e\\u305b\\u3093\\u3002</li><li>\\u305