to see the Monthly Report for.\";\na.MSG_DLG_Global_report=\"Global Report\";\na.LBL_DLG_First_logged_action=\"First logged action\";\na.LBL_DLG_Last_logged_action=\"Last logged action\";\na.LBL_DLG_Last_login_by=\"Last admin login\";\na.MSG_DLG_Last_login_by_at=\"{0} ({1})\";\na.LBL_DLG_Most_active_admin=\"Most active admin\";\na.LBL_DLG_Most_active_client=\"Most active client\";\na.MSG_DLG_Most_active_with_count=\"{0} ({1} actions)\";\na.LBL_DLG_Most_used_address=\"Most used address\";\na.LBL_DLG_Total_account_number=\"Total account number\";\na.LBL_DLG_Total_account_created=\"Total created accounts\";\na.LBL_DLG_Total_account_deleted=\"Total deleted accounts\";\na.LBL_DLG_Total_account_renamed=\"Total renamed accounts\";\na.LBL_DLG_Total_DL_created=\"Total created distribution lists\";\na.LBL_DLG_Total_DL_deleted=\"Total deleted distribution lists\";\na.LBL_DLG_Total_DL_renamed=\"Total renamed distribution lists\";\na.LBL_DLG_Total_Domains_created=\"Total domains created\";\na.LBL_DLG_Total_Domains_deleted=\"Total domains deleted\";\na.LBL_DLG_Domains_reports=\"Domain Reports\";\na.MSG_DLG_No_longins_in_month=\"No logins in the specified month\";\na.LBL_DLG_Accounts_max_accounts=\"Accounts/max accounts\";\na.LBL_DLG_Current_domain_size=\"Current Domain Size\";\na.LBL_DLG_Accounts_with_no_quota_size=\"Total size of accounts with no quota limit\";\na.LBL_DLG_System_resources_on_domains='\"System Resource\" accounts in the domain';\na.LBL_DLG_Calendar_resources_on_domains='\"Calendar Resource\" accounts in the domain';\na.LBL_DLG_Successful_domain_actions=\"Successful domain actions\";\na.LBL_DLG_Unsuccessful_domain_actions=\"Failed domain actions\";\na.LBL_DLG_Admins_reports=\"Admins Reports\";\na.LBL_DLG_Successful_logins=\"Successful logins\";\na.LBL_DLG_Unsuccessful_logins=\"Failed logins\";\na.LBL_DLG_View_mails='\"View mail\" actions';\na.LBL_DLG_Last_login=\"Last login\";\na.LBL_DLG_login_from=\"{0} from {1}\";\na.LBL_DLG_Successful_actions=\"Successful actions\";\na.LBL_DLG_Unsuccessful_actions=\"Unsuccessful actions\";\na.LBL_DLG_Generate_on_the_fly=\"Generate report on the fly?\";\na.MSG_DLG_No_report_found_for_month_delegated=\"No report available. Please contact a Global Administrator.\";\na.LBL_DLG_WIZ_Select_admin_and_action=\"Select Admin and Action\";\na.LBL_DLG_WIZ_Select_Basic=\"Basic Filter\";\na.LBL_DLG_WIZ_Select_advanced=\"Advanced Filter\";\na.LBL_DLG_WIZ_Retrieve_infos=\"Retrieve information\";\na.LBL_DLG_WIZ_Retrieving_log_infos=\"Retrieving Admin Log information\";\na.LBL_DLG_WIZ_Show_information=\"Display Log Entries\";\na.LBL_DLG_All=\"All\";\na.LBL_DLG_Success=\"Success\";\na.LBL_DLG_Failure=\"Failure\";\na.LBL_DLG_Client_IP=\"Client IP\";\na.LBL_DLG_Show_logins=\"Show Logins\";\na.LBL_DLG_Outcome=\"Outcome\";\na.LBL_DLG_admin_preferences=\"Admin preferences\";\na.LBL_DLG_Execute_Reset=\"Execute Reset\";\na.LBL_DLG_System_access=\"Number of Admin logins\";\na.LBL_DLG_send_reports_to_delegated=\"Send monthly reports to Delegated Admins via email\";\na.MSG_DLG_TOOLTIP_send_reports_to_delegated=\"Enable/Disable the delivery of monthly reports to Delegated Admins via email.\";\na.LBL_NOT_Notifications=\"Notifications\";\na.LBL_NOT_no_details=\"No details.\";\na.MSG_NOT_no_notification_selected=\"No notification selected.\";\na.ZxCore_LicenseWarningRecipients=\"Defines a list of email recipients for license-related notifications.\";\na.ZxCore_NTMail=\"Defines a list of email recipients for module-related notifications.\";\na.ZxCore_NTMailFrom=\"Defines the sender address for all email notifications.\";\na.ZxCore_MinHeapSize='Defines the minimum value of the \"mailboxd_java_heapsize\" value in releation to the total system memory.<br>Should the \"mailboxd_java_heapsize\" be lower than the percentage defined in this property, a \"WARNING\"-level notification will be issued at each mailboxd start.';\na.ZxAdmin_MaxReadableLogsFromFile=\"Define the maximum number of lines read from each logfile by the Log Browser.\";\na.ZxAdmin_MaxAdminLogLines=\"Defines the maximum number of entries displayed in the Log Browser. Should a search return more entries than the number set by this property, the full result can be delivered via email.\";\na.ZxAdmin_ViewMailEnabled='Enable or disable the \"View Mail\" feature for both Global and Delegated admins.';\na.ZxBackup_FullScanStartTime=\"Hour of the day on which the daily SmartScan and the weekly Purge are started, in 24h format.\";\na.ZxBackup_DoFullScanOnStartup='Defines whether a SmartScan is automatically started each time the \"mailboxd\" service is started.';\na.ZxBackup_DataRetentionDays=\"Number of days for which items and accounts are stored in the backup after being deleted.<br>Once out of the retention window, the item/account will be purged from the backup by the next Purge operation.\";\na.ZxBackup_FullScanPurgeWeekDay=\"Day of the week in which a Purge is executed instead of the daily SmartScan.\";\na.ZxChat_AllowUnencryptedPassword=\"Defines whether the XMPP authentication with an unencrypted password is allowed or not.\";\na.ZxChat_UseLegacySSLPort=\"Defines whether the legacy SSL port (5223) is used for XMPP connections.\";\na.ZxChat_MaxDLBuddies=\"Defines the maximum number of users that can be added to each other\\u2019s Buddy List through a Distribution List.\";\na.ZxChat_IntervalSaveUndelivered=\"Defines the interval after which an undelivered message is saved in the recipient\\u2019s mailbox.\";\na.ZxPowerstore_MoveStartTime=\"Defines the start time for the scheduled HSM Session, in 24h format. If HSM Session Scheduling is disabled, this property has no effect.\";\na.ZxPowerstore_MoveSchedulingEnabled=\"Defines whether to automatically start an HSM Session according to the appropriate scheduling.\";\na.ZxMobile_WindowSizeLimit='Maximum number of items synchronized for each SyncOp.<br>Should the number of items to synchronize be higher than this value, multiple SyncOps will be done until no more items are left.<br>To avoid synchronization issues and improve performances, the hardlimit for this value is set to \"75\", meaning that any value higher than 75 will be treated as 75.';\na.ZxMobile_FilterDaysLimit='Maximum number of days to synchronize that a device can ask for.<br>Should a device ask for more days than the value of this property, the number of days defined by this property will be sent.<br>\"0\" means \"unlimited\".';\na.ZxMobile_NotificationsLatency='Delay between the creation of an item on the server and the related Push notification.<br>This is an advanced setting, and maximum caution is advised.<br>Setting a value higher than \"40\" is highly unsuggested and might affect system performances.';\na.ZxMobile_ImapDeletedFilterEnabled='Hides emails flagged as \"deleted\" via imap to the mobile client, mimicking the behaviour of the Zimbra Web Client.<br>This is a resource-intensive feature, enabling this property might cause a performance decrease.';\na.ZxMobile_MaxPingHeartbeat='Maximum duration of a push connection. After the set amount of time has passed, the connection is closed and a new ping command is sent.<br>Setting this value to a value lower than 1200 is not recommended as it can lead to quick battery drain on mobile devices.<br>\"0\" means \"defined by the client\".';\na.ZxMobile_UseInstantNotifications='Enable \"Push\" notifications for new items.<br>If set to \"true\", devices will still able to choose a timed check instead of push notifications via client settings, while if this property is set to \"false\" no device will be able to use push notifications.';\na.pref_title_buddy_list=\"Buddy list\";\na.pref_title_display_order=\"Sort buddy list by\";\na.add_friends_username=\"Nickname\";\na.presence=\"Status\";\na.pref_title_notifications=\"Notifications\";\na.pref_title_play_sound=\"Play a sound\";\na.pref_title_flash_browser_title=\"Flash browser\\u2019s title bar\";\na.pref_title_desktop_notification_text=\"Show Desktop Notifications\";\na.pref_title_idle=\"Idle\";\na.pref_title_idle_enabled=\"Report idle status\";\na.pref_title_idle_timeout=\"Idle timeout\";\na.LBL_HSM_Store_Credential=\"S3 Bucket\";\na.LBL_CHT_Enable_History=\"Enable History\";\na.LBL_CHT_Enable_Video_Calls=\"Enable Video Calls\";\na.LBL_HSM_Add_Modify_S3_Credentials=\"Add / Edit S3 Bucket\";\na.LBL_HSM_Add_S3_Credentials=\"Add S3 Bucket\";\na.LBL_HSM_Use_new_S3_credential=\"Enter S3 Bucket information\";\na.LBL_HSM_Use_existing_S3_credential=\"Select a saved S3 Bucket\";\na.LBL_HSM_S3_Credentials=\"S3 Buckets\";\na.LBL_S3_Bucket_Name=\"Bucket Name\";\na.LBL_S3_Access_Key=\"Access Key\";\na.LBL_S3_Secret=\"Secret\";\na.LBL_S3_Destination_Path=\"Destination Path\";\na.LBL_S3_Type=\"Type\";\na.LBL_S3_Region=\"Region\";\na.LBL_S3_Protocol=\"Protocol\";\na.LBL_S3_URL=\"URL\";\na.LBL_S3_Amazon_bucket=\"Amazon S3\";\na.LBL_S3_Custom_Bucket=\"Custom\";\na.LBL_HSM_Add_volume=\"Add a new volume\";\na.LBL_HSM_Load_Credentials=\"Load S3 Bucket\";\na.LBL_HSM_Volume_Type=\"Volume Type\";\na.LBL_HSM_Local=\"Local\";\na.LBL_HSM_S3_Bucket=\"S3 Bucket\";\na.MSG_S3_No_credentials_found=\"No S3 Buckets found.\";\na.LBL_S3_Enable_infrequent_access=\"Use Infrequent Access\";\na.LBL_S3_Infrequent_access_threshold=\"when item is bigger than\";\na.LBL_HSM_cache_settings=\"S3 Cache Settings\";\na.LBL_HSM_cache_path=\"Cache Path\";\na.LBL_HSM_cache_size=\"Cache Size\";\na.MSG_HSM_Add_volume_wizard_intro='This wizard will guide you through the creation of a new secondary volume.<br>As the first step, please choose whether the volume should reside on a local directory/mountpoint or on an S3 Bucket.<br>The \"Local\" option allows to create volumes on either a local directory or a locally mounted network share/filesystem (such as NFS or Fuse shares).<br>The \"S3 Bucket\" option allows to create volumes on an existing Amazon S3 bucket.';\na.MSG_HSM_Set_as_current_help_message=\"Setting a volume as Current will mark it as the currently used volume on which data is written.<br>Non-current volumes are only used for read operations.\";\na.MSG_HSM_Set_compressed_help_message='Setting a volume as \"Compressed\" makes it so that any new item larger than the \"Compression Threshold\" value will be compressed using the gzip algorithm.<br>This can save a noticeable amount of disk space, at the cost of a slight performance decrease.<br>While this decrease is not usually noticeable, it\\u2019s highly suggested to only set Secondary volumes as compressed.';\na.LBL_Migrate_acls=\"Migrate ACLs\";\na.MSG_Operation_queued='The operation was pushed into the queue, you will be notified as soon as the operation is completed.<br>In order to monitor the progress of this operation, run the following command in a shell as the <span style=\"font-weight:bold;\">zimbra</span> user:<br><pre>{0}</pre>';\na.LBL_COR_maintenance_end=\"Maintenance End\";\na.LBL_Introduction=\"Introduction\";\na.MSG_Value_of_is_not_valid='Value of \"{0}\" is not valid';\na.MSG_HSM_S3Stores_does_not_support_deduplication=\"Volumes hosted on S3 Buckets cannot be deduplicated.\";\na.LBL_Test_s3_credentials=\"Test S3 Bucket\";\na.LBL_Checking_s3_credentials=\"Checking S3 Bucket...\";\na.LBL_S3_credentials_are_valid=\"S3 Bucket is valid.\";\na.LBL_S3_credentials_are_not_valid=\"S3 Bucket is not valid.\";\na.LBL_HSM_Volume_prefix=\"Volume Prefix\";\na.LBL_S3_AMZN_ARN=\"ARN\";\na.LBL_View_Mail=\"View Mail\";\na.MSG_HSM_S3Stores_does_not_support_statistics=\"Volumes hosted on S3 Buckets does not supports statistics.\";\na.MSG_CHT_server_running=\"Chat Server is running.\";\na.MSG_CHT_server_not_running=\"Chat Server is not running.\";\na.LBL_DLG_Log_path_dialog_title=\"Path for Admin logs\";\na.MSG_DOSFILTER_info=\"Zimbra\\u2019s DoS Filter is throttling your Zimbra Administration Console connections: this might cause slowdowns, errors and a poor user experience. For more information, visit the {0}Wiki page on Zimbra\\u2019s DOS filter{1}.\";\na.MSG_send_errors_sent=\"Client error information has been correctly sent, thank you!\";\na.MSG_send_errors_error=\"Unable to send errors.\";\na.LBL_COR_client_zimlet=\"Client Zimlet\";\na.MSG_COR_Client_zimlet_desc1='This zimlet is required in order for users to be able to manage the \"Shared Folders Sync\" feature of the Mobile Module. Make sure to enable it on any Classes of Service and Mailbox that should use this feature.';\na.MSG_BCK_Backup_destination_is_case_insensitive='The \"Backup Path\" is on a case-insensitive filesystem, but a case-sensitive filesystem is required. All backup operations will be discarded. See {0}here{1} for additional information.';\na.MSG_BCK_Backup_path_not_initialized=\"Your Backup Path seems to be uninitialized.<br>This might be because:<ul><li>This is a new installation and the Backup has never been initialized before (see {0}HERE{1}).</li><li>Your Backup Path is either unavailable or not properly configured (see {2}HERE{3}).</li></ul>\";\na.MSG_BCK_Backup_path_being_initialized=\"The Backup is already being initialized by a SmartScan, it\\u2019s not possible to start/queue another one at the moment.\";\na.MSG_BCK_Smartscan_button_tooltip=\"This operation performs a quick check of all changes happened in Zimbra since the last SmartScan and of their consistency in the Bakup.<br>Use it after an operation interruption, server crash or anytime the backup\\u2019s consistency might be at risk for a fast backup sync.\";\na.MSG_BCK_Initialize_button_tooltip=\"Initialize the Backup Module by running a SmartScan.\";\na.LBL_BCK_Restore_deleted_account_exceed_cos_limit='<b>Warning</b><br>The number of mailboxes on this domain has reached the maximum value allowed in the \"Domain Limits\" section of the Admin Module.<br>This restore mode would create an additional mailbox, thus exceeding the number mailboxes.<br>Please either:<br><ul><li> Use another restore mode.<li> Reduce the number of mailboxes on this domain.<li> Raise the mailbox limit for this domain by at least 1 more mailbox.</ul>';\na.MSG_MOB_Enable_provisioning_feature=\"WARNING: Enabling the Mobile Device Management feature may prompt your users to enable advanced security settings on their mobile devices. <br>For more information about the Mobile Device Management feature check {0}the Wiki page{1}.\";\na.MSG_MOB_Enable_MDM_server_side=\"The following settings relate to the Mobile Device Management feature of the Mobile Module, and require such feature to be enabled on the server in order to be functional.\";\na.MSG_LIC_License_voided=\"Your license has been invalidated. Please contact the sales team or your local reseller for more info.\";\na.MSG_LIC_License_about_to_expire=\"Your license expires in {0} days.\";\na.MSG_Version_zimlet_core_differs=\"A version mismatch between the Administration Zimlet and the Core has been detected.<br>The Administration Zimlet will not be loaded.<br><br><b>Core Version: {0}</b><br><b>Administration Zimlet Version: {1}</b><br><small>Build ID: {2}</small><br><br>Please make sure to install the same version of both the Administration Zimlet and the Core.\";\na.MSG_DLG_Server_ZxVersion_Mismatch=\"The version of the core installed on {0} does not match with the version installed on: {1}Please make sure that all of your mailbox servers are running the latest core version.\";\na.LBL_COR_Send_full_error_report=\"Send full error data to Zextras\";\na.MSG_DLG_Server_ZeXtras_not_installed=\"In order to be properly functional, Core must be installed on all mailbox servers in your Zimbra infrastructure: Please make sure to install the same Core version on all servers running the mailboxd service.\";\na.MSG_LIC_Unlicensed_delegated=\"Delegated Administration features have been disabled.<br>Please refer to your Global Administrator(s) for more information.\";\na.LBL_COR_client_errors=\"Client Errors\";\na.MSG_send_errors_to_zextras='This dialog box contains all client errors detected during the current client session, which can be sent to Zextras for product improvement.<br>If you wish to do so, please click the \"Send Report\" button below.';\na.MSG_COR_warning_reset_delegation=\"Warning: This will delete both Admin Module\\u2019s and Zimbra\\u2019s own Admin Delegation settings, reverting the Admin Delegation configuration to the one of a fresh Zimbra installation.<br>Please read the documentation carefully before you continue.\";\na.MSG_COR_question_enable_powerstore_on_network=\"Are you sure you want to enable the Powerstore module on Zimbra Network Edition?\";\na.MSG_COR_retrieving_trial_info=\"Retrieving Trial information.\";\na.MSG_COR_license_trial_exceed_contact_sales=\"The number of mailboxes on this infrastructure exceeds the number of licensed mailboxes. Contact {0}the Sales Team{1} in order to obtain an Extended Trial License.\";\na.LBL_BCK_stat_zxversion=\"Version\";\na.MSG_HSM_Would_you_apply_policies=\"Are you sure you want to start a Powerstore HSM Session based on the current policies?\";\na.MSG_HSM_Error_adding_policy=\"Error adding the new Policy. Check the Notifications for more information.\";\na.MSG_HSM_Error_editing_policy=\"Failed to apply the changes to the HSM Policy. Check your Notifications for more information.\";\na.MSG_CHT_version_not_supported=\"Chat Module is designed for Zimbra 8+, older Zimbra versions are not officially supported.\";\na.MSG_CHT_trying_to_deploy_older_zimlet=\"You are trying to deploy an older version of the Chat Zimlet than the one currently in use. Are you sure you want to continue?\";\na.MSG_CHT_zimlet_installed=\"The Chat Zimlet <b>is</b> installed on this infrastructure.\";\na.MSG_CHT_zimlet_installed_not_enabled=\"The Chat Zimlet <b>is</b> installed on this infrastructure but <b>is not</b> enabled.\";\na.MSG_CHT_zimlet_not_installed=\"The Chat Zimlet <b>is not</b> installed on this infrastructure.\";\na.MSG_CHT_zimlet_not_available_for_user=\"The Chat Zimlet <b>is not</b> available for this user.\";\na.MSG_CHT_zimlet_not_enabled_for_user=\"The Chat Zimlet <b>is not</b> enabled for this user.\";\na.MSG_CHT_zimlet_enabled_for_user=\"The Chat Zimlet <b>is</b> enabled for this user.\";\na.MSG_CHT_zimlet_not_available_for_cos=\"The Chat Zimlet <b>is not</b> available for this COS.\";\na.MSG_CHT_zimlet_not_enabled_for_cos=\"The Chat Zimlet <b>is not</b> enabled for this COS.\";\na.MSG_CHT_zimlet_enabled_for_cos=\"The Chat Zimlet <b>is</b> enabled for this COS.\";\na.MSG_CHT_trying_to_deploy_not_compatible=\"You are trying to deploy a version of the Chat Zimlet which is not compatible with the Chat Server. Version {0} or higher is required.\";\na.MSG_DLG_No_report_found_for_month=\"No report was found for the current month. Do you want to generate it on the fly?<br>WARNING: This operation is I/O intensive, and it may take a while depending on the size of your Admin logs.<br>Learn more about the Admin report {0}here{1}.\";\na.MSG_DLG_Cannot_show_report_module_disabled=\"Report cannot be displayed as the module is disabled.\";\na.ZxCore_NotifyUpdates='Defines whether software updates are notified in the \"Notifications\" tab of the Administration Zimlet and via email.';\na.ZxCore_OverrideNEMobile=\"Defines whether to override Zimbra Mobile in favor of Mobile Module on Zimbra Network Edition.\";\na.ZxAdmin_ModuleEnabledAtStartup='Defines whether the Admin module is automatically started together with Zimbra\\u2019s mailboxd service.<br>Setting this to \"false\" will make all module\\u2019s features unavailable at the next service start/restart.';\na.ZxAdmin_AdminLogPath=\"Defines where Admin module will save the logs needed by the Log Browser and Monthly Report features.\";\na.ZxAdmin_AdminLogEnabled='Defines whether Admin\\u2019s own logging system is enabled or disabled. Setting this value to \"false\" will affect both the \"Browse Logs\" and \"Monthly Report\" features of the module.';\na.ZxBackup_ModuleEnabledAtStartup=\"Defines whether the Backup module is enabled or disabled. Disabling the Backup module will turn off all backup and restore features.\";\na.ZxBackup_SpaceThreshold=\"Minimum free space for the device/partition containing Backup\\u2019s Backup Path.<br>When the free space on the appropriate device is lower than this threshold, Backup will stop writing on the device.<br>A notification will be sent and backup operations will be queued until there is enough free space on the device.\";\na.ZxBackup_DestPath='The path in which all Backup data will be stored.<br>This contains all backup information including items, metadata, server config and customizations as well as import mapfiles and a server lockfile.<br>The path must exist and it must be both readable and writable by the \"zimbra\" user.';\na.ZxChat_LogEnabled=\"Enables or disable the dedicated logging of Chat messages and informations.<br>The logfile is located at /opt/zimbra/log/zxchat.log.\";\na.ZxChat_ModuleEnabledAtStartup='Defines whether the Chat module is automatically started together with Zimbra\\u2019s mailboxd service. Setting this to \"false\" will make all module\\u2019s features unavailable at the next service start/restart.';\na.ZxMobile_ModuleEnabledAtStartup=\"Defines whether the Mobile module is enabled or disabled.<br>When disabled, all mobile synchronization features will be unavailable.\";\na.MSG_BCK_INTRO_Restore_wizard_undelete='This wizard will guide you through the steps required to restore all items deleted from the selected mailbox in a defined period of time. Such items will be restored within a dedicated folder named \"Undelete\" followed by the restore\\u2019s timestamp.<br><br><b>Requirements</b><ul><li> The \"Start Date\" and \"End Date\" fields mark the beginning and the end of the restore period. All items deleted between those two timestamps will be restored.</li><ul><li>Selecting the \"Use least recent date\" as the Start Date will restore all items since the oldest deleted one still within the retention period until the end date.</li><li>Selecting the \"Use most recent date\" as the End Date will restore all items since the start date until the latest deleted item within the retention period.</li></ul><li> Items moved to the Trash folder or imap-deleted but not purged are not considered as \"Deleted\" and therefor won\\u2019t be restored.</li><li>The \"Undelete\" folder will be visible in all of the Zimbra WebClient\\u2019s features, as this operation restores Emails, Contacts, Appointments, Tasks and Files.</li></ul><br>';\na.MSG_BCK_INTRO_Restore_wizard_restore_on_new='This wizard will guide you through the steps required to restored an account on this server as it was in a specific moment in time.<br><br><b>Requirements</b><ul><li> The \"Date and Time selection\" step will allow you to select a moment in time to use as the reference for the restore. You will be able to restore any account that was not marked as deleted at the chosen time.</li><ul><li>If the account you wish to restore was deleted, please use the \"Restore Deleted Account\" feature instead, available in the Backup section of the Administration Zimlet.</li></ul><li> During this wizard, you will need to select which account you wish to restore: all of the settings, classes of service and data belonging to the selected account will be restored, including aliases and passwords.</li><li>Due to the fact that this restore operates on a whole new account, share consistency will not be preserved.</li></ul>';\na.MSG_DLG_Settings_migration_is_required=\"Admin Module has detected one or more pre-existing ACLs: in order to use this module, please click the button below to migrate your current ACLs to Admin Module\";\na.MSG_DLG_Confirm_Admin_ACL_migration=\"Do you wish to migrate your current ACLs to the Admin Module?\";\na.MSG_DLG_Confirm_Admin_ACL_migration_check='I\\u2019ve read <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">the documentation</a>, understood the meaning and consequences of this one-way only action and wish to continue.';\na.MSG_View_mail_tooltip=\"Access the selected user\\u2019s mailbox - This is a Free Tool\";\na.MSG_COR_renew_isp_pending=\"Connecting to isp.zextras.com:443 to validate and renew your ISP License.\";\na.MSG_BCK_Would_you_start_smartScan='Do you really want to start a SmartScan? You will be able to monitor this operation\\u2019s progress using the <i>zxsuite backup monitor</i> command (run as the \"zimbra\" user with no arguments for usage informations).';\na.MSG_BCK_Would_you_start_purge='Do you really want to start a Backup Path Purge? You will be able to monitor this operation\\u2019s progress using the <i>zxsuite backup monitor</i> command (run as the \"zimbra\" user with no arguments for usage informations).';\na.MSG_DLG_Report_too_big_result_incomplete='Only a portion of the logs has been analyzed, results may be incomplete.<br>If you wish to increase the maximum number of log lines analyzed, please change the value of the <span style=\"font-weight:bold;\">ZxAdmin_MaxReadableLogsFromFile</span> property through the \"zxsuite admin setProperty\" CLI command.';\na.LBL_DLG_log_path_info='<br>Admin2019s dedicated log files, required in order for the the \"Admin Report\" and \"Browse Logs\" features to be functional.<br>The \"zimbra\" user must have read and write permissions on this path.<br>If you wish to change the Admin Log Path, please visit {0}THIS LINK{1}.';\na.ZxCore_SendFullErrorReports=\"Defines whether to send full error reports to Zextras for software improvement means.\";\na.ZxBackup_FullScanSchedulingEnabled='Defines whether operation scheduling is enabled or disabled. When scheduling is enabled, a SmartScan is executed daily, while once a week a Purge is executed.<br>Scheduled operations are started at the time defined by the \"ZxBackup_SmartScanStartTime\" property.';\na.MSG_Mig_and_Core_installed_please_remove_once=\"Both the com_zextras_zextras and the com_zextras_zxmig zimlets have been detected.<br>Please remove the {0} Zimlet.\";\na.LBL_ZeXtras_Notifications=\"ZeXtras Notifications\";\na.label=\"Network Modules NG\";\na.LBL_MIG_Mig_info=\"Network Modules NG Migration Tool\";\na.MSG_MIG_Info_text='<h1>Welcome to Network Modules NG Migration Tool</h1><p>In order to minimize the risk of errors, please review and follow the maintenance guidelines described- {0}HERE{1} before starting the migration.<br>Migrating your Zimbra data from one server to another will require the following three steps:<ol><li>Exporting the data from the source server (what you are doing right now).</li><li>Moving the exported data to the destination server.</li><li>Installing Network Modules NG on the destination server and importing the data.</li></ol></p><p>In order to begin the first step of the Migration, just click on the \"Start Migration\" button.<br>You\\u2019ll be asked to choose a destination folder (which must be empty and both readable and writable by the \"zimbra\" user) and the domains you wish to migrate.</p><p>More information about the Migration process and a complete guide can be found {2}here{3}<br>Network Modules NG can be downloaded from {4}here{5}<br>For additional help, please check out {6} and {7}.</p>';\na.MSG_CHT_Remove_brand=\"Remove Network Modules NG brand\";\na.LBL_NOT_zx_notifications=\"Network Modules NG Notification\";\na.ZxBackup_RealTimeScanner=\"Defines if the RealTime Scanner, Zimbra Backup Suite\\u2019s main backup engine, is enabled or disabled.<br>Disabling the RealTime scanner will turn off Zimbra Backup Suite\\u2019s real time backup features.\";\na.ZxPowerstore_EnableHsmOnNe=\"Allows Network Modules NG HSM to start HSM Sessions on Zimbra Network Edition.<br>Make sure that Zimbra\\u2019s and Network Modules NG HSM\\u2019s HSM Sessions are not ran at the same time to avoid useless I/O load.\";\na.LBL_ZxCore=\"General\";\na.LBL_CHT_Remove_Brand=\"Remove Network Modules NG Brand\";\na.MSG_COR_question_override_network_mobile_feature_enabling=\"Enabling the Mobile NG Module will deactivate the legacy mobile implementation. No user action will be required, but all clients will automatically re-synchronise all of their items.\";\na.MSG_COR_question_override_network_mobile_feature_enabling_check='I\\u2019ve read <a target=\"_blank\" target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">the documentation</a>, understood the meaning and consequences of this action and wish to continue.';\na.LBL_ZeXtras_Notifications=\"Network Modules NG Notifications\";\na.MSG_COR_not_installed=\"Network Modules NG missing. In order for all modules to be properly functional, Network Modules NG must be installed on all mailbox servers.\";\na.LBL_ZxBackup=\"Backup\";\na.LBL_ZxMobile=\"Mobile\";\na.LBL_ZxPowerstore=\"HSM\";\na.LBL_ZxAdmin=\"Admin\";\na.LBL_ZxChat=\"Chat\";\na.LBL_ZxNotifications=\"Notifications\";\na.LBL_Override_mobile_in_NG=\"Stop Zimbra Mobile\";\na.MSG_COR_checkupdate_new_version_available=\"A new version of the server {0} is available.{3}Download the package from {1}here{2}.\";\na.MSG_COR_checkupdate_new_version_core_and_chat=\"A new version of the server {0} is available.{3}Download the package from {1}here{2}.\";\na.MSG_COR_checkupdate_new_zimlet_chat_version_available=\"The server is up to date!\";\na.MSG_COR_checkupdate_core_up_to_date=\"The server is up to date!\";\na.MSG_COR_warning_new_suite_available=\"Warning: A new server version is available for download {0}HERE{1}\";\na.MSG_COR_reverting_to_trial_are_you_sure=\"You are trying to remove your License from this infrastructure.<br><br>{0}<br><br><b>Are you sure you want to continue?</b>\";\na.MSG_COR_reverting_to_trial_expired=\"All modules will be forcibly disabled, and all features will not be available anymore.\";\na.MSG_COR_reverting_to_trial_remaining_n_days=\"The server will revert back to Trial Mode, and all modules will be functional until {0}.\";\na.MSG_COR_license_trial_message=\"You are running the Trial version. {0}Obtain more information about the licensing system{1}.\";\na.MSG_COR_license_about_expire_upgrade=\"Your trial period will expire soon. {0}Obtain a license{1} to keep using all the eXtraordinary features!\";\na.MSG_COR_Module_not_licensed_upgrade=\"You need a valid license in order to enable and use the {0} module. You can obtain a new license from the Store.\";\na.LBL_BCK_Restore_deleted_account_exceed_license_limit=\"<b>Network Modules NG License Warning</b><br>The number of mailboxes on this infrastructure has reached the maximum allowed by your license.<br>This restore mode would create an additional mailbox, thus exceeding the number licensed mailboxes and disabling all Zextras Suite features.<br>Please either:<br><ul><li> Use another restore mode.<li> Reduce the number of mailboxes on the server.<li> Upload a new license including at least 1 more mailbox.</ul>\";\na.LBL_MOB_View_Mobile=\"Please check your Mobile settings.\";\na.LBL_MOB_Jump_to_MDM=\"Settings\";\na.MSG_CHT_zimlet_missing=\"Should not be displayed{0} {1}\";\na.MSG_CHT_zimlet_update_require_core_update=\"An update for the Chat Zimlet is available, but the server version you are currently running is not compatible with the new version. Please update the server to the latest version in order to be able to use the latest version of the Chat Zimlet.\";\na.MSG_COR_Commit_differ='A new build of the server <b><pre style=\"display: inline\">{0}</pre></b> is available for download {1}HERE{2}<br>For more information about the contents of the new build see the {3}CHANGELOG{2}';\na.ZxCore_LogLevel=\"Defines the verbosity level of all server logs.\";\na.ZxCore_NTLevel=\"Defines the verbosity level of all server notifications.\";\na.ZxPowerstore_ModuleEnabledAtStartup='Defines whether the HSM module is automatically started together with Zimbra\\u2019s mailboxd service.<br>Setting this to \"false\" will make all module\\u2019s features unavailable at the next service start/restart.';\na.ZxPowerstore_SpaceThreshold=\"Minimum free space for any storage HSM acts upon.<br>When the free space on the appropriate device is lower than this threshold, any Network Modules NG HSM operation will be stopped.\";\na.MSG_LIC_Maintenance_period_expired=\"Your license\\u2019s Maintenance Service subscription seems to be expired. You need to renew your subscription to use this version of the software, please contact the Sales Team.\";\na.MSG_HSM_S3_Infrequent_access_info='HSM is compatible with the \"Amazon S3 Standard - Infrequent access\" storage class, and will set any file larger than the \"Infrequent Access Threshold\" value to this storage class.<br>For more information about Infrequent Access please refer to the <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"https://aws.amazon.com/s3/storage-classes\">official Amazon S3 Documentation</a>.';\na.MSG_MIG_INTRO_Export_wizard='<b>Welcome to Migration Tool\\u2019s Export Wizard.</b><br>This wizard will guide you through the steps required to export a Migration Tool snapshot of this server\\u2019s data and configuration to a dedicated directory. You will be able to import the contents of this dataset on any server through Backup\\u2019s \"Import Backup\" feature.<br><br><b>Requirements</b><ul><li> The \"Destination Path\" is the path to the directory where your data will be exported to: it must reside on a Case Sensitive filesystem and the \"zimbra\" user must have both read and write rights on it.</li><li> The \"Minimum Space Threshold\" is a security feature that will avoid your disk being filled to its full capacity during the process: once the threshold is set, should the export operation detect that the free space on the device is lower than the value you entered it will interrupt the export and send out a notification. If this happens, you\\u2019ll need to restart the export from scratch, so make sure you have plenty of room in the device you are exporting your data into - usually 60% of the total size of your Zimbra volumes is more than enough, and in no cases the export will take more space than said total.</li><li> During this wizard, you will need to select which domains you wish to export: all of the settings, classes of service and mailboxes belonging to the selected domains will be exported.</li></ul><br>For more information visit the <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">Backup Wiki</a>';\na.MSG_BCK_INTRO_Export_wizard='<b>Welcome to Backup Export Wizard.</b><br>This wizard will guide you through the steps required to export a Backup snapshot of this server\\u2019s data and configuration to a dedicated directory. You will be able to import the contents of this dataset on any server running through Backup\\u2019s \"Import Backup\" feature.<br><br><b>Requirements</b><ul><li> The \"Destination Path\" is the path to the directory where your data will be exported to: it must reside on a Case Sensitive filesystem and the \"zimbra\" user must have both read and write rights on it.</li><li> The \"Minimum Space Threshold\" is a security feature that will avoid your disk being filled to its full capacity during the process: once the threshold is set, should the export operation detect that the free space on the device is lower than the value you entered it will interrupt the export and send out a notification. If this happens, you\\u2019ll need to restart the export from scratch, so make sure you have plenty of room in the device you are exporting your data into - usually 60% of the total size of your Zimbra volumes is more than enough, and in no cases the export will take more space than said total.</li><li> During this wizard, you will need to select which domains you wish to export: all of the settings, classes of service and mailboxes belonging to the selected domains will be exported.</li></ul><br>For more information visit the <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">Backup Wiki</a>';\na.MSG_BCK_INTRO_Import_wizard='<b>Welcome to Import Wizard.</b><br>This wizard will guide you through the steps required to import a Backup dataset to this server.<br><br><b>Requirements</b><ul><li> The \"Source Path\" is the path to the directory where your exported data is: it must reside on a Case Sensitive filesystem and the \"zimbra\" user must have both read and write rights on it.</li><li> During this wizard, you will need to select which domains and accounts you wish to import: all of the settings and classes of service and mailboxes belonging to the selected domains/accounts will be imported, unless otherwise specified in the \"Select Source Path\" step.</li></ul><br>For more information visit the <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">Backup Wiki</a>';\na.MSG_BCK_INTRO_Restore_deleted_account_wizard='<b>Welcome to Backup Restore Deleted Account wizard.</b><br>This wizard will guide you through the steps required to restored a deleted account on this server.<br><br><b>Requirements</b><ul><li> The \"Date and Time selection\" step will allow you to select a moment in time to use as the reference for the restore. You will be able to restore any account that was marked as deleted at the chosen time.</li><li> The deleted account you wish to restore must still be within the backup\\u2019s retention period. <ul><li>If the deleted account rotated out of retention and a Backup Purge was executed, its data has been deleted from the Backup Path and cannot be restored.</li></ul><li> During this wizard, you will need to select which account you wish to restore: all of the settings, classes of service and data belonging to the selected account will be restored, including aliases and passwords.</li><li>Due to the fact that the original account has been deleted, share consistency will not be preserved.</li></ul><br>For more information visit the <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">Backup Wiki</a>';\na.MSG_BCK_INTRO_Restore_wizard_generic='<b>Welcome to the Restore Wizard.</b><br>This wizard allows you to choose two different Restore Modes, \"Undelete Restore\" and \"Restore on New Account\" and will guide you through the steps required to start either one according to your choice.<br><br>For more information visit the <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">Backup Wiki</a>';\na.MSG_DLG_INTRO_Browse_log_wizard='<b>Welcome to the \"Browse Logs\" feature.</b><br>From here, you will be able to easily search and browse the server\\u2019s logs tracking both specific actions and the activity of your administrators.<br><br>For more information visit the <a target=\"_blank\" target=\"_blank\" target=\"_blank\" href=\"{0}\">Admin Wiki</a>';\ndelete a;\nif(!window.com_zextras_zextras){\ncom_zextras_zextras={}\n}\na=com_zextras_zextras;\na.LBL_here=\"\\u3053\\u3053\";\na.LBL_Until=\"\\u301c\\u307e\\u3067\";\na.LBL_Since=\"\\u304b\\u3089\";\na.LBL_Expired=\"\\u671f\\u9650\\u5207\\u308c\";\na.LBL_Ok=\"Ok\";\na.LBL_Accounts=\"\\u30a2\\u30ab\\u30a6\\u30f3\\u30c8\";\na.LBL_SERVER_LIST_Server=\"\\u30b5\\u30fc\\u30d0\\u30fc\";\na.LBL_SERVER_LIST_Notifications=\"\\u901a\\u77e5\";\na.LBL_SERVER_LIST_License_info=\"\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u60c5\\u5831  \";\na.LBL_OP_Details=\"\\u30aa\\u30da\\u30ec\\u30fc\\u30b7\\u30e7\\u30f3\\u306e\\u8a73\\u7d30\";\na.LBL_OP_Description=\"\\u30aa\\u30da\\u30ec\\u30fc\\u30b7\\u30e7\\u30f3\";\na.LBL_OP_Module=\"\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\";\na.LBL_OP_Name=\"\\u30aa\\u30da\\u30ec\\u30fc\\u30b7\\u30e7\\u30f3\\u540d\";\na.LBL_OP_Id=\"ID\";\na.LBL_OP_Status=\"\\u72b6\\u614b\";\na.LBL_OP_Host=\"\\u30db\\u30b9\\u30c8\";\na.LBL_OP_Start_Time=\"\\u30b9\\u30bf\\u30fc\\u30c8\\u6642\\u9593\";\na.LBL_OP_Queued_Time=\"\\u5f85\\u3061\\u884c\\u5217\\u306e\\u6642\\u9593\";\na.MSG_MOD_Sure_want_disable_module=\"<b>\\u8b66\\u544a</b><br>{0}\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u306e\\u81ea\\u52d5\\u8d77\\u52d5\\u6a5f\\u80fd\\u3092\\u7121\\u52b9\\u306b\\u3057\\u3088\\u3046\\u3068\\u3057\\u3066\\u3044\\u307e\\u3059\\u3002<br>Zimbra \\u304c\\u8d77\\u52d5/\\u5