\u30f3\\u30b9\\u30c8\\u30fc\\u30eb\";\na.LI_UNLIMITED=\"\\u7121\\u5236\\u9650\";\na.LI_NOLICENSE=\"\\u6709\\u52b9\\u306a\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u304c\\u30a4\\u30f3\\u30b9\\u30c8\\u30fc\\u30eb\\u3055\\u308c\\u3066\\u3044\\u307e\\u305b\\u3093\\u3002\";\na.LI_GETLICENSE_ERROR_MSG=\"\\u30b5\\u30fc\\u30d0\\u30fc\\u304b\\u3089\\u6709\\u52b9\\u306a\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u60c5\\u5831\\u3092\\u53d6\\u5f97\\u3067\\u304d\\u307e\\u305b\\u3093\\u3002\\u65b0\\u3057\\u3044\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u3092\\u30a4\\u30f3\\u30b9\\u30c8\\u30fc\\u30eb\\u3059\\u308b\\u306b\\u306f\\u3001[\\u30b0\\u30ed\\u30fc\\u30d0\\u30eb\\u8a2d\\u5b9a]>[\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9]>[\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u3092\\u66f4\\u65b0]\\u306b\\u30a2\\u30af\\u30bb\\u30b9\\u3057\\u3066\\u304f\\u3060\\u3055\\u3044\\u3002\";\na.UploadLicenseErrorMsg=\"\\u30a2\\u30c3\\u30d7\\u30ed\\u30fc\\u30c9\\u30b9\\u30c6\\u30fc\\u30bf\\u30b9{0}\\uff1a\\u73fe\\u6642\\u70b9\\u3067\\u306f\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u30d5\\u30a1\\u30a4\\u30eb\\u306e\\u30a2\\u30c3\\u30d7\\u30ed\\u30fc\\u30c9\\u306b\\u5931\\u6557\\u3002\";\na.ErrorTryAgain=\"<br />\\u30a8\\u30e9\\u30fc\\u3092\\u4fee\\u6b63\\u3057\\u3066\\u518d\\u8a66\\u884c\\u3057\\u3066\\u304f\\u3060\\u3055\\u3044\\u3002\";\na.consoleLicenseExpired=\"\\u304a\\u4f7f\\u3044\\u306eZimbra\\u30cd\\u30c3\\u30c8\\u30ef\\u30fc\\u30af\\u306e{0}\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u306f{1}\\u65e5\\u524d\\u306b\\u671f\\u9650\\u304c\\u5207\\u308c\\u3066\\u3044\\u307e\\u3059\\u3002\";\na.licenseWillExpire=\"\\u304a\\u4f7f\\u3044\\u306eZimbra\\u30cd\\u30c3\\u30c8\\u30ef\\u30fc\\u30af\\u306e{0}\\u30e9\\u30a4\\u30bb\\u30f3\\u30b9\\u306f\\u3042\\u3068{1}\\u65e5\\u3067\\u671f\\u9650\\u304c\\u5207\\u308c\\u307e\\u3059\\u3002\";\na.licenseLoseSupport=\"\\u304a\\u4f7f\\u3044\\u306eZimbra\\u30cd\\u30c3\\u30c8\\u30ef\\u30fc\\u30af\\u306e\\u30b5\\u30dd\\u30fc\\u30c8\\u306f\\u3001{0}\\u65e5\\u524d\\u306b\\u6709\\u52b9\\u671f\\u9650\\u304c\\u52