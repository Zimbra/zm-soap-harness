_zimbraAutoProvLdapStartTlsEnabled=\"Enabled StartTls\";\na.LBL_zimbraAutoProvLdapAdminBindDn=\"Admin bind DN for external LDAP:\";\na.MSG_zimbraAutoProvLdapAdminBindDn=\"Admin bind DN\";\na.LBL_zimbraAutoProvLdapAdminBindPassword=\"Admin bind password:\";\na.MSG_zimbraAutoProvLdapAdminBindPassword=\"Admin bind password\";\na.LBL_zimbraAutoProvLdapSearchBase=\"Search base:\";\na.MSG_zimbraAutoProvLdapSearchBase=\"Search base\";\na.LBL_zimbraAutoProvLdapSearchFilter=\"Search filter:\";\na.MSG_zimbraAutoProvLdapSearchFilter=\"Search filter\";\na.LBL_zimbraAutoProvLdapBindDn=\"Bind DN for local LDAP:\";\na.MSG_zimbraAutoProvLdapBindDn=\"Bind DN\";\na.LBL_zimbraAutoProvAccountNameMap=\"Account name map:\";\na.LBL_zimbraAutoProvAttrMap=\"Attribute map:\";\na.LBL_zimbraAutoProvNotificationFromAddress=\"Notification from address:\";\na.LBL_zimbraAutoProvBatchSize=\"Batch size:\";\na.MSG_zimbraAutoProvBatchSize=\"Batch size\";\na.LBL_zimbraAutoProvLastPolledTimestamp=\"Last polled timestemp:\";\na.LBL_zimbraAutoProvPollingInterval=\"Auto provision polling interval:\";\na.LBL_zimbraAutoProvScheduledDomains=\"Provision scheduled domains:\";\na.LBL_zimbraAutoProvServerList=\"Scheduled servers:\";\na.TBB_zimbraAutoProvEmailSetting=\"Email notification\";\na.LBL_zimbraAutoProvConfiguration=\"Configuration\";\na.LBL_zimbraAutoProvEmailSubject=\"Email Subject:\";\na.LBL_zimbraAutoProvEmailBody=\"Email Body:\";\na.TTL_zimbraAutoProvEmailSettingBold=\"<b>Email Setting:</b>\";\na.TTL_zimbraAutoProvEmailSetting=\"Email Setting\";\na.ERROR_AUTOPROV_MODE=\"Provision mode is required.\";\na.ERROR_AUTOPROV_LAZYAUTH=\"Auth mechanisms is required for automatic lazy provisioning.\";\na.ERROR_AUTOPROV=\"The value of {0} is required.\";\na.MSG_AUTOPROV_NOTE=\"Scheduled domains and polling interval should also be set in server or global configuration.\";\na.DTBB_AutoProvConfigWiz=\"Configure AutoProvision\";\na.DTBB_AutoProvConfigWiz_tt=\"Open the wizard that will guide you through configuring Auto Provision Mechanism\";\na.NAD_AutoProvConfigTitle=\"Auto-provision Configuration Wizard\";\na.NAD_WizConfigComplete=\"Auto-provision configuration complete\";\na.NAD_Prov_ConfigSummary=\"Summary of auto-provision settings\";\na.LBL_setPassword=\"set\";\na.LBL_unsetPassword=\"unset\";\na.LBL_ManualProvision=\"Manual provisioning\";\na.LBL_ApplyButton=\"Apply\";\na.LBL_ManualProvAccount=\"Account for manual provision\";\na.MSG_NOTE_zimbraAutoProvMode=\"This wizard will guide you configure the auto-provision. First, choose the provision mode: <ol><li>Automatic eager provisioning: A server maintenance thread automatically polls the configured external auto provision LDAP source, and then auto creates the accounts in Zimbra directory. </li><li>Automatic lazy provisioning: auto creates the Zimbra account when user first login via one of the external auth mechanisms enabled for auto provisioning.</li><li>Manual provisioning: admin to search from the configured external auto provision LDAP source and select an entry from the search result to create the corresponding Zimbra account for the external entry.</li></ol>\";\na.MSG_NOTE_zimbraAutoProvAuthMech=\"The LAZY mode requires the following external authentication mechanisms. When a user authenticates via one of following mechanisms, and when the user account does not yet exist in Zimbra directory, an account entry will be automatically created in Zimbra directory.\";\na.MSG_NOTE_otherConfigStep=\"<ol><li>Account name mapping specifies the attribute name in the external directory that contains localpart of the account name (e.g. uid).</li> <li>Attribute map for mapping attribute values from the external entry to Zimbra account attributes. Values are in the format of {external attribute}={zimbra attribute}. </li><li>For eager provisioning, batch size is displayed and required for max number of accounts to process; polling interval and scheduled servers will also be required, and will set to given servers.</li></ol>\";\na.MSG_AUTOPROV_MANUAL=\"<ol><li> Search the external auto-provision source directory and list users.</li> <li> Select accounts and click OK to do auto provision. </li></ol>\";\na.BUSY_AUTOPROV_MANUAL=\"Provisioning account ...\";\na.BUSY_AUTOPROV_GETACCT=\"Getting provision account ...\";\na.DLG_TITILE_MANUAL_PROV=\"Set password for provisioned accounts\";\na.TABT_AccountQuota=\"Account Quota\";\na.TBB_AUTOPROV_GENERAL=\"General\";\na.TBB_AUTOPROV_EAGER=\"Eager mode\";\na.TBB_AUTOPROV_LAZY=\"Lazy mode\";\na.TBB_AUTOPROV_MANUAL=\"Manual mode\";\na.MSG_LDAP_CHANGED=\"LDAP configuration is changed. Do you want to apply them ?\";\na.MSG_AUTOPROV_DLG_EAGER=\"<ol><li><b>Automatic eager provisioning</b>: A server maintenance thread automatically polls the configured external auto provision LDAP source, and then auto creates the accounts in Zimbra directory. </li><li><b>Batch size</b>: it is required for max number of accounts to process.</li><li><b>Auto provision polling interval</b> and <b>Scheduled servers</b> will use to be set configuration to given servers. Both of them are required to activate eager mode.</li><li><b>Search filter</b> of LDAP configuration is required to be set for this provision also.</li></ol>\";\na.MSG_AUTOPROV_DLG_LAZY=\"<ol><li><b>Automatic lazy provisioning</b>: auto creates the Zimbra account when user first login via one of the external auth mechanisms enabled for auto provisioning.</li><li><b>External authentication mechanism</b>:The lazy mode requires the above external authentication mechanisms. When a user authenticates via one of above mechanisms, and when the user account does not yet exist in Zimbra directory, an account entry will be automatically created in Zimbra directory.</li></ol>\";\na.MSG_AUTOPROV_MANUAL_PASSSET=\"<b>Warning!</b> Auto provision has not configured one attribute mapping for userPassword. If not configured, provisioned account will not have a zimbra password and the domain must be configured to do authentication with external LDAP/AD. But, you can reset password for provisioned account.\";\na.LBL_provisionedAccountPassword=\"Reset provisioned account password(s) to:\";\na.AuthSetting_Spnego=\"SPNEGO Global and Server Setting\";\na.AuthSetting_SpnegoDomain=\"SPNEGO Domain Setting\";\na.SpnegoGlobalConfig=\"Change Global SPNEGO Setting ...\";\na.SpnegoServerConfig=\"Change Server SPNEGO Setting ...\";\na.SpnegoDomainConfig=\"Change Domain SPNEGO Setting ...\";\na.EnableSpnegoGlobal=\"Enable SPNEGO authentication\";\na.stepAuthModeForDomain=\"Authentication Mode\";\na.stepAuthSetting=\"Authentication Settings\";\na.stepAuthBindLDAP=\"LDAP Bind\";\na.stepAuthSummary=\"Authentication Config Summary\";\na.stepLDAPAuthSetting=\"LDAP Settings\";\na.authForDomainMsg=\"<b>Authentication mode for this domain</b>\";\na.authForADMsg=\"<b>Active Directory Settings</b>\";\na.authForLDAPMsg=\"<b>External LDAP Setting</b>\";\na.authSummaryMsg=\"<b>Authentication Configuration Summary</b>\";\na.authForSpnegoSettingMsg=\"<b>SPNEGO Server Settings</b>\";\na.spnegoSettingSSOMsg=\"<b>Single Sign-On using SPNEGO</b>\";\na.SpnegoSettingGlobalDialogTitle=\"Global SPNEGO Setting\";\na.SpnegoSettingServerDialogTitle=\"Server SPNEGO Setting\";\na.SpnegoSettingAllBrowsers=\"All Browsers\";\na.SpnegoSettingSupportedBrowsers=\"Supported Browsers\";\na.SpnegoSettingCustomBrowsers=\"Advanced\";\na.SpnegoSettingCustomDialogTitle=\"Login URL Browser Access\";\na.SpnegoSettingCustomDialogHeader=\"Enter browser allowed to access the Login and Logout URLs in regular expression form\";\na.SpnegoSettingCustomDialogHelp=\"For example, to honor the Login and Lougout URL for Firefox, Internet Explorer, Chrome, and Safari on computers running Windows, and Safari on Apple Mac computers, use: <br><br>\\u2018.*Windows.*Firefox/3.*\\u2019<br>\\u2018.*MSIE.*Windows.*\\u2019<br>\\u2018.*Windows.*Chrome.*\\u2019<br>\\u2018.*Macintosh.*Safari.*\\u2019\";\na.spnegoGlobalSettingEmpty=\"Global SPNEGO Setting is empty\";\na.spnegoGlobalSettingUnenabled=\"Global SPNEGO Setting is disabled\";\na.spnegoGlobalSettingUnempty=\"Global SPNEGO Setting is set\";\na.spnegoGlobalSettingMsg=\"Global setting for SPNEGO much be configured prior to using this feature.\";\na.spnegoGlobalSettingTitle=\"<b>SPNEGO Global Setting</b>\";\na.spnegoServerSettingMsg=\"Server setting for SPNEGO much be configured prior to using this feature.\";\na.spnegoGlobalSettingPageTitle=\"<b>Single Sign-On using SPNEGO</b>\";\na.spnegoServerSettingPageTitle=\"<b>Server Configuration</b>\";\na.spnegoTagetServer=\"Server:\";\na.spnegoVirtualHostMsg=\"These are the virtual host names to access the Zimbra Web Client UI. Example: example.com.\";\na.spnegoWebClientLoginMsg=\"Login URL is the URL to redirect users to when Zimbra auth token expires. Example: ../../service/spnego\";\na.spnegoWebClientLogoutMsg=\"Logout URL is the URL to display when users logs out. Example: ../?sso=1\";\na.spnegoAllowedUASetting=\"Web Client Allowed User Agents\";\na.spnegoAllowedUASetting_specify=\"Specifiy...\";\na.domainAuthDlgInternalHelp=\"The Internal LDAP authentication method assumes the Zimbra schema running on the OpenLDAP directory server.\";\na.domainAuthDlgADHelp=\"The  Active Directory authentication mechanism attempts to bind to the directory server using Microsoft Active Directory directory services for authentication.\";\na.domainAuthDlgExternalHelp=\"The External LDAP authentication mechanism attempts to bind to the directory server using the supplied user name and password.\";\na.MSG_WorkingTask=\"Work in Progress\";\na.MSG_RunningTask=\"Running Tasks\";\na.MSG_ServerStatus=\"Server Status\";\na.LBL_QuickSearch=\"Search\";\na.LBL_SaveSearch=\"Save Search\";\na.MSG_HomeLoading=\"Loading...\";\na.LBL_HomeGetStared=\"Get Started\";\na.LBL_HomeInstallLicense=\"Install License...\";\na.LBL_HomeInstallCert=\"Install Certificates\";\na.LBL_HomeConfigureCos=\"Configure Default COS\";\na.LBL_HomeSetupDomain=\"Set up Domain\";\na.LBL_HomeCreate