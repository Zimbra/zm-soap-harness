f\\u7528\\u3057\\u3066\\u3001\\u6709\\u52b9\\u306a\\u30d5\\u30a1\\u30a4\\u30eb\\u3092\\u9078\\u629e\\u3057\\u3066\\u304f\\u3060\\u3055\\u3044\\u3002\";\ndelete a;// properties for ZaMsg not found\n// Basename: /res/ZabMsg\nif (!window.ZabMsg) { ZabMsg = {}; }\na=ZabMsg;\na.favIconUrl=\"/img/logo/favicon.ico\";\na.LBL_zimbraPrefAdminConsoleWarnOnExit=\"Display a warning when administrators try to navigate away from Zimbra Administration Console\";\na.ERROR_ZCS_NOT_RUNNING=\"Cannot connect to Zimbra server. Please make sure that Zimbra is running.\";\na.zimbraAdminTitle=\"Zimbra Administration\";\na.HELP_PAGE_0=\"Zimbra Administrator\\u2019s Help Center\";\na.HELP_PAGE_1=\"Below are links to Zimbra documentation and forums, to help you find answers to your questions about using the Zimbra Collaboration Server.\";\na.HELP_PAGE_2=\"Zimbra Online Help\";\na.HELP_PAGE_3=\"To learn how to use the administration console, click the Zimbra Online Help link.\";\na.HELP_PAGE_6=\"Zimbra Forums\";\na.HELP_PAGE_7=\"Get answers to your questions from the Zimbra forum. You can search for answers from the postings, and you can post a question.\";\na.HELP_PAGE_8=\"Zimbra Administration Guide\";\na.HELP_PAGE_9=\"The Administration Guide manual describes the Zimbra system architecture, the Zimbra components, the administration functions, and the CLI commands.\";\na.HELP_PAGE_13=\"The Zimbra wiki includes articles the support team and community have written in response to troubleshooting and administration issues that were not covered in the documentation.\";\na.HELP_OTHER_GUIDES_CONNNECTOR_INFO=\"Use Zimbra with other clients? Check out these guides.\";\na.zimbraTitle=\"Zimbra Administration Console\";\na.about_title=\"Zimbra&trade; Administration Console\";\na.HELP_WIKI_LINK=\"https://wiki.zimbra.com\";\na.LBL_HomeZimbraVersion=\"Zimbra Version:\";\na.LBL_HomeHelpCenter=\"Zimbra Help Center\";\na.LBL_HomeMsgCount=\"Message Count:\";\na.LBL_HomeMsgVolume=\"Message Volume:\";\na.attrDesc_mailHost=\"Server:\";\na.About_Button_Label=\"About Zimbra Version\";\na.zimbraHomePage=\"Zimbra Home Page\";\na.zimbraAbout=\"About Zimbra...\";\na.aboutScreenCopyright=\"Zimbra {0} (build {1})<br><br> Copyright \\u00a9 2005-{2} Synacor, Inc. All rights reserved. This product is protected by U.S. and international copyright and intellectual property laws. \\\"Zimbra\\\" is a registered trademark of Synacor, Inc. in the United States and other jurisdictions. All other marks and names mentioned herein may be trademarks of their respective companies.<br><br> Synacor, Inc. <a href=\\\"http://www.synacor.com\\\" target=\\\"_blank\\\">www.synacor.com</a>\";\na.splashScreenCopyright=\"Copyright \\u00a9 2005-{0} Synacor, Inc. All rights reserved. \\\"Zimbra\\\" is a registered trademark of Synacor, Inc.\";\na.clientLevelNotice=\"<a target=\\\"_new\\\" href=\\\"https://www.zimbra.com\\\">Zimbra</a> :: the leader in open source messaging and collaboration :: <a target=\\\"_new\\\" href=\\\"https://blog.zimbra.com\\\">Blog</a> - <a target=\\\"_new\\\" href=\\\"https://wiki.zimbra.com\\\">Wiki</a> - <a target=\\\"_new\\\" href=\\\"https://www.zimbra.com/forums\\\">Forums</a>\";\na.ZWC_END_USER_GUIDE=\"ZWC End User Guide for 8.0\";\na.ZWC_END_USER_GUIDE_INFO=\"The end user guide describes the features and applications used in the Zimbra Web Client.\";\na.MessageContent=\"message\";\na.OVP_dlSearchResult=\"Distribution Lists\";\na.HELP_CENTER_TITLE=\"Zimbra Administrator Help Center\";\na.onlineHelpDetail=\"To learn how to use the administration console, click the Zimbra Online Help link. For details about new features and issues that have been resolved in this release, go to the <a target=\\\"_new\\\" href=\\\"{0}\\\">Zimbra Collaboration Server Documentation</a> page and read the release notes.\";\na.HELP_topMigrationQuestions=\"Top Migration Questions\";\na.HELP_adminGuide=\"Administrators Guide\";\na.HELP_adminGuideDetail=\"The Administration Guide manual describes the Zimbra system architecture, the Zimbra components, the administration functions, and the CLI commands.\";\na.HELP_usersGuide=\"End Users Guide\";\na.HELP_usersGuideDetail=\"The end user guide describes the feature and applications used in the Zimbra Web Client.\";\na.HELP_askCommunity=\"Ask the Community\";\na.HELP_askCommunityItem1=\"<a target=\\\"_new\\\" href=\\\"https://www.zimbra.com/forums\\\">Zimbra Forums</a> is a great place to get answers to your questions. You can search for answers from the postings, and you can post a question.\";\na.HELP_askCommunityItem2=\"<a target=\\\"_new\\\" href=\\\"https://wiki.zimbra.com\\\">Zimbra Wiki</a> includes articles the support team and community have written in response to troubleshooting and administration issues that were not covered in the documentation\";\na.HELP_MIG_Q1=\"How do I migrate server email accounts from Exchange into Zimbra?\";\na.HELP_MIG_Q2=\"How can my users import the contents of a .pst file from a Microsoft Outlook 2003, 2007, 2010 mailbox into Zimbra?\";\na.HELP_MIG_Q3=\"How do I migrate server email accounts from Domino into Zimbra?\";\na.HELP_MIG_Q4=\"How do I migrate calendar data over using the iCalendar Migration Tool?\";\ndelete a;if (!window.ZabMsg) { ZabMsg = {}; }\na=ZabMsg;\na.favIconUrl=\"/img/logo/favicon.ico\";\na.LBL_zimbraPrefAdminConsoleWarnOnExit=\"\\u7ba1\\u7406\\u8005\\u304c\\u7ba1\\u7406\\u30b3\\u30f3\\u30bd\\u30fc\\u30eb\\u753b\\u9762\\u304b\\u3089\\u4ed6\\u306e\\u30da\\u30fc\\u30b8\\u30d8\\u79fb\\u52d5\\u3057\\u3088\\u3046\\u3068\\u3059\\u308b\\u3068\\u304d\\u306b\\u8b66\\u544a\\u3092\\u8868\\u793a\";\na.ERROR_ZCS_NOT_RUNNING=\"Zimbra\\u30b5\\u30fc\\u30d0\\u30fc\\u306b\\u63a5\\u7d9a\\u3067\\u304d\\u307e\\u305b\\u3093\\u3002Zimbra\\u304c\\u5b9f\\u884c\\u3055\\u308c\\u3066\\u3044\\u308b\\u3053\\u3068\\u3092\\u78ba\\u8a8d\\u3057\\u3066\\u304f\\u3060\\u3055\\u3044\\u3002\";\na.zimbraAdminTitle=\"Zimbra Administration\";\na.HELP_PAGE_0=\"Zimbra Administrator\\u30d8\\u30eb\\u30d7\\u30