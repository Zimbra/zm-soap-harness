_cos_limit=\"<b>\\u8b66\\u544a</b><br>\\u3053\\u306e\\u30c9\\u30e1\\u30a4\\u30f3\\u3067\\u5229\\u7528\\u53ef\\u80fd\\u306a\\u30e1\\u30fc\\u30eb\\u30dc\\u30c3\\u30af\\u30b9\\u6570\\u306e\\u4e0a\\u9650\\u306b\\u9054\\u3057\\u307e\\u3057\\u305f\\u3002\\u4e0a\\u9650\\u5024\\u306f Admin\\u30e2\\u30b8\\u30e5\\u30fc\\u30eb\\u306e \\\"\\u30c9\\u30e1\\u30a4\\u30f3\\u5236\\u9650\\\" \\u30bb\\u30af\\u30b7\\u30e7\\u30f3\\u3067\\u898f\\u5b9a\\u3055\\u308c\\u3066\\u3044\\u307e\\u3059\\u3002<br> \\u3053\\u306e\\u5fa9\\u5143\\u65b9\\u6cd5\\u3067\\u306f\\u3001\\u8ffd\\u52a0\\u3067\\u30e1\\u30fc\\u30eb\\u30dc\\u30c3\\u30af\\u30b9\\u3092\\u4f5c\\u6210\\u3057\\u3053\\u306e\\u4e0a\\u9650\\u6570\\u3092\\u8d85\\u3048\\u308b\\u53ef\\u80fd\\u6027\\u304c\\u3042\\u308a\\u307e\\u3059\\u3002<br>\\u554f\\u984c\\u3092\\u56de\\u907f\\u3059\\u308b\\u305f\\u3081\\u306b\\u3001\\u4ee5\\u4e0b\\u306e\\u65b9\\u6cd5\\u3092\\u3069\\u308c\\u304b\\u9078\\u629e\\u3057\\u3066\\u4e0b\\u3055\\u3044: <br><ul><li>\\u5225\\u306e\\u5fa9\\u5143\\u65b9\\u6cd5\\u3092\\u4f7f\\u3046\\u3002<li>\\u3053\\u306e\\u30c9\\u30e1\\u30a4\\u30f3\\u5185\\u306e\\u65e2\\u5b58\\u30e1\\u30fc\\u30eb\\u30dc\\u30c3\\u30af\\u30b9\\u3092\\u6e1b\\u3089\\u3059\\u3002<li>\\u3053\\u306e\\u30c9\\u30e1\\u30a4\\u30f3\\u306b\\u5bfe\\u3059\\u308b\\u30e1\\u30fc\\u30eb\\u30dc\\u30c3\\u30af\\u30b9\\u5272\\u5f53\\u6570\\u3092\\u5c11\\u306a\\u304f\\u3068\\u3082\\u3001\\u73fe\\u5728\\u3088\\u308a1\\u30e1\\u30fc\\u30eb\\u30dc\\u30c3\\u30af\\u30b9\\u5206\\u5897\\u3084\\u3059\\u3002</ul>\";\na.MSG_MOB_Enable_provisioning_feature=\"\\u8b66\\u544a: \\u30e2\\u30d0\\u30a4\\u30eb\\u30c7\\u30d0\\u30a4\\u30b9\\u7ba1\\u7406\\u6a5f\\u80fd\\u3092\\u6709\\u52b9\\u306b\\u3059\\u308b\\u3068\\u3001\\u30a8\\u30f3\\u30c9\\u30e6\\u30fc\\u30b6\\u306b\\u5bfe\\u3057\\u3066\\u3001\\u30e2\\u30d0\\u30a4\\u30eb\\u30c7\\u30d0\\u30a4\\u30b9\\u4e0a\\u306e\\u8a73\\u7d30\\u30bb\\u30ad\\u30e5\\u30ea\\u30c6\\u30a3\\u8a2d\\u5b9a\\u3092\\u30aa\\u30f3\\u306b\\u3059\\u308b\\u3088\\u3046\\u306a