<t:tests xmlns:t="urn:zimbraTestHarness">

	<!-- Following bug is included as part of this test case -->
	<!-- ZCS-4832: Create configuration file for CalDav and CardDav -->

	<t:property name="account1.uname" value="test.${TIME}.${COUNTER}" />
	<t:property name="account1.name" value="${account1.uname}@${defaultdomain.name}" />
	<t:property name="account1.password" value="${defaultpassword.value}" />


	<t:test_case testcaseid="Ping" type="always">
		<t:objective>basic system check</t:objective>
			
		 <t:test id="ping">
	        <t:request>
	            <PingRequest xmlns="urn:zimbraAdmin"/>
	        </t:request>
	        <t:response>
	            <t:select path="//admin:PingResponse"/>
	        </t:response>
         </t:test>

	</t:test_case>

	<t:test_case testcaseid="zcs-4832_account_setup" type="q4fix">
		<t:objective>create test account</t:objective>


		<t:test id="admin_login" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>

		<t:test required="true">
			<t:request>
				<CreateAccountRequest xmlns="urn:zimbraAdmin">
					<name>${account1.name}</name>
					<password>${account1.password}</password>
				</CreateAccountRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateAccountResponse/admin:account"
					attr="id" set="account1.id" />
				<t:select
					path='//admin:CreateAccountResponse/admin:account/admin:a[@n="zimbraMailHost"]'
					set="account1.server" />
			</t:response>
		</t:test>


	</t:test_case>

	<t:test_case testcaseid="zcs-4832-Caldav" type="q4fix">
		<t:objective>Download the caldav mobile config file using rest api
		</t:objective>
		<t:steps>
			1. Account 1 user hits rest URI to download caldav mobile
			config file
			2. Verify common config details in the response.
		</t:steps>

		<t:test required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAccount">
					<account by="name">${account1.name}</account>
					<password>${account1.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//acct:AuthResponse/acct:lifetime" match="^\d+$" />
				<t:select path="//acct:AuthResponse/acct:authToken" set="authToken" />
			</t:response>
		</t:test>

		<t:resttest>
			<t:restServletRequest>
				<configType>caldav</configType>
				<fmt>mobileconfig</fmt>
			</t:restServletRequest>
			<t:restServletResponse>
				<t:select match=".?key>CalDAVAccountDescription.?.?key>"
					emptyset="0" />
				<t:select match=".?string>${account1.uname}'s CALDAV.?.?string>"
					emptyset="0" />
				<t:select match=".?key>CalDAVHostName.?.?key>" emptyset="0" />
				<t:select match=".?string>${defaultdomain.name}.?.?string>"
					emptyset="0" />
				<t:select match=".?key>CalDAVPassword.?.?key>" emptyset="0" />
				<t:select match=".?string.?>" emptyset="0" />
				<t:select match=".?key>CalDAVPort.?.?key>" emptyset="0" />
				<t:select match=".?integer>443.?.?integer>" emptyset="0" />
				<t:select match=".?key>CalDAVPrincipalURL.?.?key>"
					emptyset="0" />
				<t:select
					match=".?string>.?dav.?${account1.uname}@${defaultdomain.name}.?Calendar.?.?.?string>"
					emptyset="0" />
				<t:select match=".?key>CalDAVUsername.?.?key>" emptyset="0" />
				<t:select match=".?string>${account1.name}.?.?string>"
					emptyset="0" />
				<t:select match=".?key>PayloadDisplayName.?.?key>"
					emptyset="0" />
				<t:select match=".?string>caldav ${account1.uname}.?.?string>"
					emptyset="0" />
				<t:select match=".?key>PayloadType.?.?key>" emptyset="0" />
				<t:select match=".?string>com.apple.caldav.account.?.?string>"
					emptyset="0" />
			</t:restServletResponse>
		</t:resttest>

	</t:test_case>


