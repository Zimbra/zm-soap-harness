						        <t:CalendarItem>
						          <t:Subject>${appt.subject1}</t:Subject>
						          <t:Sensitivity>Normal</t:Sensitivity>
						          <t:Body BodyType="HTML">${appt.content1}</t:Body>
						          <t:Importance>Normal</t:Importance>						          
						          <t:Start>${Time1}</t:Start>
						          <t:End>${Time2}</t:End>
