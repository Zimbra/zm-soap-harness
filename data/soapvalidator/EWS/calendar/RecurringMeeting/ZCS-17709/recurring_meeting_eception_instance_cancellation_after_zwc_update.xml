<t:tests xmlns:t="urn:zimbraTestHarness">

    <!-- Following bug is included as part of this test case -->
    <!--ZCS-17709:- EWS Outlook - Recurring instance modified in ZWC not removed from attendee's ZWC calendar after
    outlook instance deletion for meeting containing attachment-->

    <t:property name="test_account1.username" value="testAccount1${TIME}.${COUNTER}"/>
    <t:property name="test_account1.name" value="${test_account1.username}@${defaultdomain.name}"/>
    <t:property name="test_account1.password" value="test123"/>

    <t:property name="test_account2.username" value="testAccount2${TIME}.${COUNTER}"/>
    <t:property name="test_account2.name" value="${test_account2.username}@${defaultdomain.name}"/>
    <t:property name="test_account2.password" value="test123"/>

    <t:property name="message.subject1" value="subject1${TIME}.${COUNTER}"/>
    <t:property name="message.updated_subject2" value="updated_subject2${TIME}.${COUNTER}"/>

    <t:test_case testcaseid="Ping" type="always">
        <t:objective>basic system check</t:objective>
        <t:test required="true">
            <t:request>
                <PingRequest xmlns="urn:zimbraAdmin"/>
            </t:request>
            <t:response>
                <t:select path="//admin:PingResponse"/>
            </t:response>
        </t:test>
    </t:test_case>

    <t:test_case testcaseid="acct_setup" type="always">
        <t:objective>Create test accounts</t:objective>

        <t:test id="admin_login" required="true">
            <t:request>
                <AuthRequest xmlns="urn:zimbraAdmin">
                    <name>${admin.user}</name>
                    <password>${admin.password}</password>
                </AuthRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:AuthResponse/admin:authToken" set="authToken"/>
            </t:response>
        </t:test>

        <t:test id="create_test_account1" depends="admin_login" required="false">
            <t:request>
                <CreateAccountRequest xmlns="urn:zimbraAdmin">
                    <name>${test_account1.name}</name>
                    <password>${test_account1.password}</password>
                    <a n="zimbraFeatureEwsEnabled">TRUE</a>
                </CreateAccountRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAccountResponse/admin:account" attr="id" set="test_account1.id"/>
            </t:response>
        </t:test>

        <t:test id="create_test_account2" depends="admin_login" required="false">
            <t:request>
                <CreateAccountRequest xmlns="urn:zimbraAdmin">
                    <name>${test_account2.name}</name>
                    <password>${test_account2.password}</password>
                    <a n="zimbraFeatureEwsEnabled">TRUE</a>
                </CreateAccountRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAccountResponse/admin:account" attr="id" set="test_account2.id"/>
            </t:response>
        </t:test>
    </t:test_case>

    <t:test_case testcaseid="CancelExceptionInstanceOfRecurringMeetingAfterZWCUpdate" type="sanity" bugids="ZCS-17709">
        <t:objective>Create recurring meeting, create an exception, update from ZWC, then delete instance from Outlook and verify removal in Zimbra</t:objective>
        <t:steps>
            1. Create recurring meeting via EWS CreateItem.
            2. Verify the recurring meeting.
            3. Update item to finalize ChangeKey.
            4. Create exception (update occurrence) via EWS UpdateItem (OccurrenceItemId).
            5. Update that exception from ZWC (ModifyAppointmentRequest).
            6. Get occurrence item id (GetItem).
            7. Delete the occurrence via EWS CreateItem/CancelCalendarItem.
            8. Verify exception is removed in Zimbra (SearchRequest).
            9. Verify attendee received cancellation mail with updated subject.
        </t:steps>

        <!-- Step 1: Create recurring meeting via EWS -->
        <t:test>
            <t:request ews="true" username="${test_account1.name}" password="${test_account1.password}">
                <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
                               xmlns:t="http://schemas.microsoft.com/exchange/services/2006/types"
                               xmlns:m="http://schemas.microsoft.com/exchange/services/2006/messages">
                    <soap:Body>
                        <m:CreateItem MessageDisposition="SaveOnly" SendMeetingInvitations="SendToAllAndSaveCopy">
                            <m:SavedItemFolderId>
                                <t:FolderId Id="10"/>
                            </m:SavedItemFolderId>
                            <m:Items>
                                <t:CalendarItem>
                                    <t:Subject>${message.subject1}</t:Subject>
                                    <t:Start>2025-09-23T09:00:00+05:30</t:Start>
                                    <t:End>2025-09-23T10:00:00+05:30</t:End>
                                    <t:LegacyFreeBusyStatus>Busy</t:LegacyFreeBusyStatus>
                                    <t:Recurrence>
                                        <t:DailyRecurrence>
                                            <t:Interval>1</t:Interval>
                                        </t:DailyRecurrence>
                                        <t:EndDateRecurrence>
                                            <t:StartDate>2025-09-23</t:StartDate>
                                            <t:EndDate>2025-09-26</t:EndDate>
                                        </t:EndDateRecurrence>
                                    </t:Recurrence>
                                    <t:RequiredAttendees>
                                        <t:Attendee>
                                            <t:Mailbox>
                                                <t:Name>${test_account2.username}</t:Name>
                                                <t:EmailAddress>${test_account2.name}</t:EmailAddress>
                                            </t:Mailbox>
                                        </t:Attendee>
                                    </t:RequiredAttendees>
                                </t:CalendarItem>
                            </m:Items>
                        </m:CreateItem>
                    </soap:Body>
                </soap:Envelope>
            </t:request>
            <t:response>
                <t:select path="//ewsmsg:CreateItemResponseMessage" attr="ResponseClass" match="Success"/>
                <t:select path="//ewsmsg:CreateItemResponseMessage//ewstype:ItemId" attr="Id"
                          set="recurring.master.id"/>
                <t:select path="//ewsmsg:CreateItemResponseMessage//ewstype:ItemId" attr="ChangeKey"
                          set="recurring.master.ck"/>
            </t:response>
        </t:test>

        <t:delay msec="2000"/>

        <!-- Step 2: CreateAttachment to add a file onto the meeting (use ChangeKey from Step1) -->
        <t:test>
            <t:request ews="true" username="${test_account1.name}" password="${test_account1.password}">
                <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
                               xmlns:t="http://schemas.microsoft.com/exchange/services/2006/types"
                               xmlns:m="http://schemas.microsoft.com/exchange/services/2006/messages">
                    <soap:Body>
                        <m:CreateAttachment>
                            <m:ParentItemId Id="${recurring.master.id}" ChangeKey="${recurring.master.ck}"/>
                            <m:Attachments>
                                <t:FileAttachment>
                                    <t:Name>test.txt</t:Name>
                                    <t:ContentType>text/plain</t:ContentType>
                                    <t:Content>VGVzdCBhdHRhY2htZW50IGNvbnRlbnQ=</t:Content>
                                </t:FileAttachment>
                            </m:Attachments>
                        </m:CreateAttachment>
                    </soap:Body>
                </soap:Envelope>
            </t:request>
            <t:response>
                <t:select path="//ewsmsg:CreateAttachmentResponseMessage" attr="ResponseClass" match="Success"/>
                <t:select path="//ewsmsg:CreateAttachmentResponseMessage//ewstype:AttachmentId" attr="Id"
                          set="recurring.attach.id"/>
                <t:select path="//ewsmsg:CreateAttachmentResponseMessage//ewstype:AttachmentId" attr="RootItemChangeKey"
                          set="recurring.master.ck2"/>
            </t:response>
        </t:test>

        <t:delay msec="1000"/>

        <!-- Step 3: UpdateItem to finalize new ChangeKey on the meeting (use ck2 from attachment response) -->
        <t:test>
            <t:request ews="true" username="${test_account1.name}" password="${test_account1.password}">
                <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
                               xmlns:t="http://schemas.microsoft.com/exchange/services/2006/types"
                               xmlns:m="http://schemas.microsoft.com/exchange/services/2006/messages">
                    <soap:Body>
                        <m:UpdateItem SendMeetingInvitationsOrCancellations="SendToNone" MessageDisposition="SaveOnly"
                                      ConflictResolution="AlwaysOverwrite">
                            <m:ItemChanges>
                                <t:ItemChange>
                                    <t:ItemId Id="${recurring.master.id}" ChangeKey="${recurring.master.ck2}"/>
                                    <t:Updates>
                                        <t:SetItemField>
                                            <t:FieldURI FieldURI="item:Subject"/>
                                            <t:CalendarItem>
                                                <t:Subject>${message.subject1}</t:Subject>
                                            </t:CalendarItem>
                                        </t:SetItemField>
                                    </t:Updates>
                                </t:ItemChange>
                            </m:ItemChanges>
                        </m:UpdateItem>
                    </soap:Body>
                </soap:Envelope>
            </t:request>
            <t:response>
                <t:select path="//ewsmsg:UpdateItemResponseMessage" attr="ResponseClass" match="Success"/>
                <t:select path="//ewsmsg:UpdateItemResponseMessage//ewstype:ItemId" attr="Id"
                          set="recurring.updated.id"/>
            </t:response>
        </t:test>

        <t:delay msec="3000"/>

        <!-- Step 4: Create an exception (update occurrence #2) via EWS (OccurrenceItemId) -->
        <t:test>
            <t:request ews="true" username="${test_account1.name}" password="${test_account1.password}">
                <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
                               xmlns:t="http://schemas.microsoft.com/exchange/services/2006/types"
                               xmlns:m="http://schemas.microsoft.com/exchange/services/2006/messages">
                    <soap:Header>
                        <t:RequestServerVersion Version="Exchange2010_SP2"/>
                        <t:MailboxCulture>en-GB</t:MailboxCulture>
                        <t:TimeZoneContext>
                            <t:TimeZoneDefinition Id="India Standard Time"/>
                        </t:TimeZoneContext>
                    </soap:Header>
                    <soap:Body>
                        <UpdateItem xmlns="http://schemas.microsoft.com/exchange/services/2006/messages"
                                    ConflictResolution="AutoResolve"
                                    SendMeetingInvitationsOrCancellations="SendToAllAndSaveCopy">
                            <ItemChanges>
                                <t:ItemChange>
                                    <t:OccurrenceItemId RecurringMasterId="${recurring.master.id}"
                                                        ChangeKey="${recurring.master.ck2}"
                                                        InstanceIndex="2"/>
                                    <t:Updates>
                                        <t:SetItemField>
                                            <t:FieldURI FieldURI="item:Subject"/>
                                            <t:CalendarItem>
                                                <t:Subject>${message.updated_subject2}</t:Subject>
                                            </t:CalendarItem>
                                        </t:SetItemField>
                                        <t:SetItemField>
                                            <t:FieldURI FieldURI="calendar:Start"/>
                                            <t:CalendarItem>
                                                <t:Start>2025-09-24T06:00:00+05:30</t:Start>
                                            </t:CalendarItem>
                                        </t:SetItemField>
                                        <t:SetItemField>
                                            <t:FieldURI FieldURI="calendar:End"/>
                                            <t:CalendarItem>
                                                <t:End>2025-09-24T07:00:00+05:30</t:End>
                                            </t:CalendarItem>
                                        </t:SetItemField>
                                    </t:Updates>
                                </t:ItemChange>
                            </ItemChanges>
                        </UpdateItem>
                    </soap:Body>
                </soap:Envelope>
            </t:request>
            <t:response>
                <t:select path="//ewsmsg:UpdateItemResponseMessage" attr="ResponseClass" match="Success"/>
                <t:select path="//ewsmsg:UpdateItemResponseMessage//ewstype:ItemId" attr="Id" set="updated.invId"/>
            </t:response>
        </t:test>

        <t:delay msec="4000"/>

        <!-- Step 5: Authenticate organizer in Zimbra (for ModifyAppointmentRequest & verification) -->
        <t:test required="true">
            <t:request>
                <AuthRequest xmlns="urn:zimbraAccount">
                    <account by="name">${test_account1.name}</account>
                    <password>${test_account1.password}</password>
                </AuthRequest>
            </t:request>
            <t:response>
                <t:select path="//acct:AuthResponse/acct:authToken" set="authToken"/>
            </t:response>
        </t:test>

        <t:delay msec="3000"/>

        <!-- Step 6: Find the updated exception in Zimbra and capture its id -->
        <t:test>
            <t:request>
                <SearchRequest xmlns="urn:zimbraMail" types="appointment" calExpandInstStart="1758393000000"
                               calExpandInstEnd="1758911400000" limit="1000" offset="0">
                    <query>(inid:"10")</query>
                </SearchRequest>
            </t:request>
            <t:response>
                <t:select path="//mail:SearchResponse/mail:appt/mail:inst[@ex='1']" attr="invId" set="updated.invId"/>
            </t:response>
        </t:test>

        <t:test>
            <t:request>
                <GetMsgRequest xmlns="urn:zimbraMail">
                    <m id="${updated.invId}"/>
                </GetMsgRequest>
            </t:request>
            <t:response>
                <t:select path="//mail:GetMsgResponse/mail:m/mail:inv/mail:comp" attr="name"
                          match="${message.updated_subject2}"/>
                <t:select path="//mail:GetMsgResponse/mail:m/mail:inv/mail:comp/mail:s" attr="d"
                          match="20250924T060000"/>
            </t:response>
        </t:test>

        <t:delay msec="2000"/>

        <!-- Step 7: Modify the exception from ZWC (ModifyAppointmentRequest) -->
        <t:test>
            <t:request>
                <ModifyAppointmentRequest xmlns="urn:zimbraMail" id="${updated.invId}" comp="0" sendInv="true">
                    <m l="10">
                        <su>${message.updated_subject2}</su>
                        <inv>
                            <comp name="${message.updated_subject2}" loc="">
                                <s tz="Asia/Kolkata" d="20250924T063000"/>
                                <e tz="Asia/Kolkata" d="20250924T073000"/>
                                <exceptId d="20250924T033000Z"/>
                                <fb>B</fb>
                                <allDay>0</allDay>
                                <class>PUB</class>
                                <status>CONF</status>
                            </comp>
                        </inv>
                    </m>
                </ModifyAppointmentRequest>
            </t:request>
            <t:response>
                <t:select path="//mail:ModifyAppointmentResponse" attr="invId" set="inv.id"/>
            </t:response>
        </t:test>

        <!-- Follow-up verification via GetMsg -->
        <t:test>
            <t:request>
                <GetMsgRequest xmlns="urn:zimbraMail">
                    <m id="${inv.id}"/>
                </GetMsgRequest>
            </t:request>
            <t:response>
                <t:select path="//mail:GetMsgResponse/mail:m/mail:inv/mail:comp" attr="name"
                          match="${message.updated_subject2}"/>
                <t:select path="//mail:GetMsgResponse/mail:m/mail:inv/mail:comp/mail:s" attr="d"
                          match="20250924T063000"/>
                <t:select path="//mail:GetMsgResponse/mail:m/mail:inv/mail:comp/mail:e" attr="d"
                          match="20250924T073000"/>
                <t:select path="//mail:GetMsgResponse/mail:m/mail:inv/mail:comp" attr="ridZ" match="20250924T033000Z"/>
            </t:response>
        </t:test>

        <t:delay msec="2000"/>

        <!-- Step 8: Get the occurrence item id for instance index 2 using EWS GetItem -->
        <t:test>
            <t:request ews="true" username="${test_account1.name}" password="${test_account1.password}">
                <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
                               xmlns:t="http://schemas.microsoft.com/exchange/services/2006/types"
                               xmlns:m="http://schemas.microsoft.com/exchange/services/2006/messages">
                    <soap:Body>
                        <GetItem xmlns="http://schemas.microsoft.com/exchange/services/2006/messages">
                            <ItemShape>
                                <t:BaseShape>IdOnly</t:BaseShape>
                            </ItemShape>
                            <ItemIds>
                                <t:OccurrenceItemId RecurringMasterId="${recurring.master.id}" InstanceIndex="2"/>
                            </ItemIds>
                        </GetItem>
                    </soap:Body>
                </soap:Envelope>
            </t:request>
            <t:response>
                <t:select path="//ewsmsg:GetItemResponseMessage" attr="ResponseClass" match="Success"/>
                <t:select path="//ewsmsg:GetItemResponseMessage//ewstype:ItemId" attr="Id" set="cancel.target.id"/>
                <t:select path="//ewsmsg:GetItemResponseMessage//ewstype:ItemId" attr="ChangeKey"
                          set="cancel.target.ck"/>
            </t:response>
        </t:test>

        <t:delay msec="1000"/>
        <!-- Step 9: Cancel exception (occurrence) from Outlook -->
        <t:test>
            <t:request ews="true" username="${test_account1.name}" password="${test_account1.password}">
                <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
                               xmlns:t="http://schemas.microsoft.com/exchange/services/2006/types"
                               xmlns:m="http://schemas.microsoft.com/exchange/services/2006/messages">
                    <soap:Body>
                        <m:CreateItem MessageDisposition="SendAndSaveCopy"
                                      SendMeetingInvitations="SendToAllAndSaveCopy">
                            <m:Items>
                                <t:CancelCalendarItem>
                                    <t:ReferenceItemId Id="${cancel.target.id}" ChangeKey="${cancel.target.ck}"/>
                                </t:CancelCalendarItem>
                            </m:Items>
                        </m:CreateItem>
                    </soap:Body>
                </soap:Envelope>
            </t:request>
            <t:response>
                <t:select path="//ewsmsg:CreateItemResponseMessage" attr="ResponseClass" match="Success"/>
                <t:select path="//ewsmsg:CreateItemResponseMessage//ewstype:ItemId" attr="Id" set="cancel.inv.id"/>
            </t:response>
        </t:test>

        <t:delay msec="5000"/>
        <!-- Step 10: Verify in Zimbra that the exception instance is removed -->
        <t:test>
            <t:request>
                <SearchRequest xmlns="urn:zimbraMail" types="appointment"
                               calExpandInstStart="1758642600000"
                               calExpandInstEnd="1758729000000">
                    <query>(inid:"10")</query>
                </SearchRequest>
            </t:request>
            <t:response>
                <t:select path="//mail:SearchResponse" emptyset="true"/>
            </t:response>
        </t:test>

        <!-- Step 11: Verify attendee received cancellation mail with updated subject -->
        <t:test required="true">
            <t:request>
                <AuthRequest xmlns="urn:zimbraAccount">
                    <account by="name">${test_account2.name}</account>
                    <password>${test_account2.password}</password>
                </AuthRequest>
            </t:request>
            <t:response>
                <t:select path="//acct:AuthResponse/acct:authToken" set="authToken"/>
            </t:response>
        </t:test>

        <t:delay msec="5000"/>

        <t:test>
            <t:request>
                <SearchRequest xmlns="urn:zimbraMail" types="message">
                    <query>subject:${message.updated_subject2}</query>
                </SearchRequest>
            </t:request>
            <t:response>
                <t:select path="//mail:SearchResponse/mail:m" attr="id" set="attendee.cancel.msg.id"/>
            </t:response>
        </t:test>

        <t:test>
            <t:request>
                <GetMsgRequest xmlns="urn:zimbraMail">
                    <m id="${attendee.cancel.msg.id}"/>
                </GetMsgRequest>
            </t:request>
            <t:response>
                <t:select path="//*[local-name()='m']" attr="su" match="Cancelled: ${message.updated_subject2}"/>
                <t:select path="//*[local-name()='inv']/*[local-name()='comp']" attr="method" match="CANCEL"/>
            </t:response>
        </t:test>

    </t:test_case>
</t:tests>
