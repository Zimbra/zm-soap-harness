         </t:request>
         <t:response>
            <t:select path="//acct:AuthResponse/acct:authToken" set="authToken" />
         </t:response>
      </t:test>
   
      <t:test>
         <t:request>
            <SearchRequest xmlns="urn:zimbraMail" types="appointment">
               <query>subject:${appt.subject1}</query>
            </SearchRequest>
         </t:request>
         <t:response>
            <t:select path="//mail:SearchResponse/mail:appt" attr="invId" set="inv.id" />
            <t:select path="//mail:SearchResponse/mail:appt" attr="name" match="${appt.subject1}" />
         </t:response>
      </t:test>
   
      <t:test>
         <t:request>
            <GetMsgRequest xmlns="urn:zimbraMail">
               <m id="${inv.id}" />
            </GetMsgRequest>
         </t:request>
         <t:response>
            <t:response>
               <t:select path="//mail:GetMsgResponse/mail:m/mail:mp//mail:mp[@ct='image/png']" attr="ct" match="image/png" count="2" />
               <t:select path="//mail:GetMsgResponse/mail:m/mail:mp//mail:mp[@ct='image/png' and @cd='inline']" attr="cd" match="inline" />
               <t:select path="//mail:GetMsgResponse/mail:m/mail:mp//mail:mp[@ct='image/png' and @cd='inline']" attr="ci" match=".*image001\.png.*" regex="true" />
               <t:select path="//mail:GetMsgResponse/mail:m/mail:mp//mail:mp[@ct='image/png' and @cd='attachment']" attr="cd" match="attachment" />
               <t:select path="//mail:GetMsgResponse/mail:m/mail:mp//mail:mp[@ct='image/png' and @cd='attachment']" attr="filename" match="image.jpeg" />
