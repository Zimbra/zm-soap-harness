<t:tests xmlns:t="urn:zimbraTestHarness">
	
	<t:property name="storageType_AWS_S3" value="AWS_S3" />
	<t:property name="storageType_CEPH_S3" value="CEPH_S3" />
	<t:property name="storageType_NetApp_S3" value="STORAGE_GRID_S3" />	
	<t:property name="storageType_EMC_S3" value="EMC_S3" />
	<t:property name="storageType_Scality_S3" value="SCALITY_S3" />
	<t:property name="storageType_CUSTOM_S3" value="CUSTOM_S3" />	
	<t:property name="bucketStatus" value="ACTIVE" />
	<t:property name="storageType" value="S3" />
	<t:property name="destinationPathAws" value="/opt/zimbra/aws${COUNTER}${TIME}" />
	<t:property name="destinationPathCeph" value="/opt/zimbra/ceph${COUNTER}${TIME}" />
	<t:property name="destinationPathStorageGrid" value="/opt/zimbra/StorageGrid${COUNTER}${TIME}" />
