	<t:property name="server.zimbraAdmin" value="${zimbraServer.name}" />

<t:test_case testcaseid="Ping" type="always">
		<t:objective>basic system check</t:objective>

		<t:test required="true">
			<t:request>
				<PingRequest xmlns="urn:zimbraAdmin" />
			</t:request>
			<t:response>
				<t:select path="//admin:PingResponse" />
			</t:response>
		</t:test>
</t:test_case>

<t:test_case testcaseid="create_S3Buckets_01" type="bhr" areas="StorageManagement" depends="ping">
		<t:objective>Verify user should be able to Add and get AWS S3/Ceph/StorageGrid/EMC/Scality/Custom S3 buckets</t:objective>
		<t:steps>
			1. Login as the Admin
			2. Fire CreateS3BucketConfigRequest with valid details
			3. Verify buckets are getting added successfully
		</t:steps>

		<t:test id="Login01" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>

		<t:test id="CreateS3Bucket_AWS" required="true">
			<t:request>
				<CreateS3BucketConfigRequest xmlns="urn:zimbraAdmin">
					 <a n="bucketName">${SM.AWS.BUCKET.NAME}</a>
        			 <a n="storeProvider">${storageType_AWS_S3}</a>
       			     <a n="secretKey">${SM.AWS.SECRET.KEY}</a>
        			 <a n="accessKey">${SM.AWS.ACCESS.KEY}</a>
        			 <a n="protocol">HTTPS</a>
                     <a n="region">${SM.AWS.REGION}</a>
                     <a n="url">${SM.AWS.BASE.URI}</a>
                     <a n="destinationPath">${destinationPathAws}</a>
	 			</CreateS3BucketConfigRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='globalBucketUUID']" set="aws.globalBucketUUID" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketName']" match="${SM.AWS.BUCKET.NAME}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='storeProvider']" match="${storageType_AWS_S3}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='accessKey']" match="${SM.AWS.ACCESS.KEY}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketStatus']" match="ACTIVE" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='region']" match="${SM.AWS.REGION}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='url']" match="${SM.AWS.BASE.URI}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='destinationPath']" match="${destinationPathAws}" /> 
			</t:response>
		</t:test>
		
		<t:test id="GetS3Bucketaws">
			<t:request>
				<GetS3BucketConfigRequest xmlns="urn:zimbraAdmin">
					<a n="globalBucketUUID">${aws.globalBucketUUID}</a>
	 			</GetS3BucketConfigRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:GetS3BucketConfigResponse/admin:a[@n='globalBucketUUID']" match="${aws.globalBucketUUID}" />"
				<t:select path="//admin:GetS3BucketConfigResponse/admin:a[@n='bucketName']" match="${SM.AWS.BUCKET.NAME}" />
			</t:response>
		</t:test>
		
