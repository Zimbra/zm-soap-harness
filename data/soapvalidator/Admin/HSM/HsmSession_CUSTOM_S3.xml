<t:tests xmlns:t="urn:zimbraTestHarness">

	<t:property name="name1" value="CUSTOM_S3_Volume1${COUNTER}${TIME}" />
	<t:property name="type_secondary" value="2" />	
	<t:property name="storeType_external" value="2" />	
	<t:property name="storageType_CUSTOM_S3" value="CUSTOM_S3" />
	<t:property name="volumePrefix" value="vp_CUSTOM_S3_volume" />
	<t:property name="bucketStatus" value="ACTIVE" />
	<t:property name="storageType" value="S3" />
	<t:property name="destinationPath" value="/opt/zimbra/CUSTOM_S3" />
	<t:property name="server.zimbraAdmin" value="${zimbraServer.name}" />
	<t:property name="hsm.policy" value="zimbraHsmPolicy"/>
	<t:property name="hsm.policy.age" value="message:before:-15days"/>
	<t:property name="messages.dir" value="${testMailRaw.root}/email02"/>
	<t:property name="messages.content" value="Now is the time for all good men to come to the aid of their country"/>
	
<t:test_case testcaseid="Ping" type="always">
		<t:objective>basic system check</t:objective>

		<t:test required="true">
			<t:request>
				<PingRequest xmlns="urn:zimbraAdmin" />
			</t:request>
			<t:response>
				<t:select path="//admin:PingResponse" />
			</t:response>
		</t:test>
</t:test_case>

<t:test_case testcaseid="Configure_bucket" type="always">
		<t:objective>Configure CUSTOM_S3 bucket for creating volumes</t:objective>

		<t:test id="Login01" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>

		 <t:test id="CreateS3Bucket_CUSTOM_S3" required="true">
			<t:request>
				<CreateS3BucketConfigRequest xmlns="urn:zimbraAdmin">
					 <a n="storeProvider">${storageType_CUSTOM_S3}</a>
					 <a n="bucketName">${SM.CEPH.BUCKET.NAME}</a>
       			     <a n="secretKey">${SM.CEPH.SECRET.KEY}</a>
        			 <a n="accessKey">${SM.CEPH.ACCESS.KEY}</a>
                     <a n="url">${SM.CEPH.BASE.URI}</a>
                     <a n="destinationPath">${destinationPath}</a>
	 			</CreateS3BucketConfigRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='globalBucketUUID']" set="CUSTOM_S3.globalBucketUUID" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketName']" match="${SM.CEPH.BUCKET.NAME}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='storeProvider']" match="${storageType_CUSTOM_S3}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='accessKey']" match="${SM.CEPH.ACCESS.KEY}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketStatus']" match="${bucketStatus}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='url']" match="${SM.CEPH.BASE.URI}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='destinationPath']" match="${destinationPath}" />
			</t:response>
		</t:test>

		<t:test id="GetServerId" required="true">
			<t:request>
				<GetServerRequest xmlns="urn:zimbraAdmin">
					<server by="name">${zimbraServer.name}</server>
				</GetServerRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:GetServerResponse/admin:server" attr="id" set="server.id"/>
			</t:response>
		</t:test>

</t:test_case>


<t:test_case testcaseid="CUSTOM_S3_BlobMovement_01" type="bhr" areas="StorageManagement" depends="Configure_bucket">
		<t:objective>Create local primary volume and secondary volume as CUSTOM_S3 and verify emails are getting moved to secondary volume with 1 minute older messages HSM policy</t:objective>
		<t:steps>
			1. Login to Admin account
			2. Create a secondary volume of Storage Type = CUSTOM_S3
			3. Verify volume details by GetVolumeRequest
			4. Run GetHsmStatusRequest and abort session to kill any running session, verify it again using GetHsmStatusRequest
			5. Set created CUSTOM_S3 secondary volume as current secondary volume
			6. Get total number of mailboxes using HsmRequest and GetHsmStatusRequest
			7. Modify SM policy
			8. Create one test account
			9. Run HSM to move existing mails those are matching with the policy 
			10. Then inject 3 test mails to test account , login using test account and get injected mails
			11.Login to Admin account, run SM session 
			12.Verify GetHsmStatusRequest returned with 3 mails
			13.Login using test account and verify mails are accessible using GetMsgRequest
		</t:steps>

		<t:test id="Login01" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>
		
		<!-- Create secondary volume of type CUSTOM_S3 -->
		<t:test id="CreateVolume01" depends="Login01" required="true">
			<t:request>
				<CreateVolumeRequest xmlns="urn:zimbraAdmin">
					<volume type="${type_secondary}" name="${name1}" storeType="${storeType_external}">
						<volumeExternalInfo storageType="${storageType}" volumePrefix="${volumePrefix}" globalBucketConfigId="${CUSTOM_S3.globalBucketUUID}" />
					</volume>
				</CreateVolumeRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="id" set="volume1.id" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="name" match="${name1}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="type" match="${type_secondary}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="storageType" match="${storageType}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="volumePrefix" match="${volumePrefix}-${server.id}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="globalBucketConfigId" match="${CUSTOM_S3.globalBucketUUID}" />
			</t:response>
		</t:test>

		<!-- Get the information of created CUSTOM_S3 volume -->
		<t:test depends="CreateVolume01">
			<t:request>
				<GetVolumeRequest xmlns="urn:zimbraAdmin" id="${volume1.id}" />
			</t:request>
			<t:response>
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="id" match="${volume1.id}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="name" match="${name1}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="type" match="${type_secondary}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="storageType" match="${storageType}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="volumePrefix" match="${volumePrefix}-${server.id}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="globalBucketConfigId" match="${CUSTOM_S3.globalBucketUUID}" />
			</t:response>
		</t:test>

		<!-- Get the HSM status to abort it -->
		<t:test id="GetHsmStatus01" depends="CreateVolume01" required="true">
        	<t:request>
				<GetHsmStatusRequest xmlns="urn:zimbraAdmin"/>
       		</t:request>
        <t:response>
             	<t:select path="//admin:GetHsmStatusResponse" />
        </t:response>
    </t:test>

	<!-- Abort the HSM session and Get the HSM status and verify it's not in running state -->
	<t:test >
		<t:request depends="GetHsmStatus_HsmRequest01" >
			<AbortHsmRequest  xmlns="urn:zimbraAdmin" action="cancel"/>
		</t:request>
	</t:test>

	<t:for start="1" end="180" break="response">
		<t:delay msec="1000"/>
		<t:test >
			<t:request>
				<GetHsmStatusRequest xmlns="urn:zimbraAdmin"/>
			</t:request>
			<t:response>
				<t:select path="//admin:GetHsmStatusResponse[@running='0']" query="response" />
			</t:response>
		</t:test>
	</t:for>
	
	<!-- Set created CUSTOM_S3 secondary volume as current secondary volume -->
	<t:test id="SetCurrentVolumeRequest" required="true">
		<t:request>
			<SetCurrentVolumeRequest xmlns="urn:zimbraAdmin">
				<id>${volume1.id}</id>
				<type>2</type>
			</SetCurrentVolumeRequest>
		</t:request>
		<t:response>
			<t:select path="//admin:SetCurrentVolumeResponse"/>
		</t:response>
	</t:test>
	
	<!-- Get total number of mailboxes using HsmRequest and GetHsmStatusRequest -->
	<t:test >
		<t:request id="HsmSession01" depends="GetHsmStatus01" >
			<HsmRequest xmlns="urn:zimbraAdmin"/>
		</t:request>
        <t:response>
             <t:select path="//admin:HsmResponse"/>
        </t:response>
	</t:test>
    
	<t:for start="1" end="300" break="response0">
	
		<t:delay msec="1000"/>
	
		<t:test id="GetHsmStatus01" depends="HsmSession01" required="true">
			<t:request>
				<GetHsmStatusRequest xmlns="urn:zimbraAdmin"/>
			</t:request>
			<t:response>
				 <t:select path="//admin:GetHsmStatusResponse[@running='0']" query="response0">
					 <t:select attr="totalMailboxes" set="crtMailboxes"/>
				 </t:select>
			</t:response>
		</t:test>
	
	</t:for>

	 <!-- Get server ID to modify HSM age/HSM policy -->	
	 <t:test id="getallserversrequest01" depends="Login01">
        <t:request>
            <GetAllServersRequest xmlns="urn:zimbraAdmin"/>
        </t:request>
        <t:response>
             <t:select path='//admin:GetAllServersResponse/admin:server[admin:a[@n="zimbraServiceEnabled"]="mailbox"][1]' attr="id" set="server.id1"/>
        </t:response>
    </t:test>
    
    <!-- Modify HSM policy on server -->
    <t:test id="ModifyServer01">
        <t:request>
            <ModifyServerRequest xmlns="urn:zimbraAdmin">
                <id>${server.id1}</id>
                <a n="${hsm.policy}">${hsm.policy.age}</a>
            </ModifyServerRequest>
        </t:request>
        <t:response>
            <t:select path="//admin:ModifyServerResponse/admin:server" attr="id" set="server.id1"/>
        </t:response>
    </t:test>

	<!-- Get the modified HSM policy age -->
    <t:test id="ServerRequest01">
        <t:request>
            <GetServerRequest xmlns="urn:zimbraAdmin">
                <server by="id">${server.id1}</server>
            </GetServerRequest>
        </t:request>
        <t:response>
            <t:select path="//admin:GetServerResponse/admin:server[@id='${server.id1}']">
            	<t:select path="//admin:a[@n='zimbraHsmPolicy']" match="${hsm.policy.age}"/>
            </t:select>
        </t:response>
    </t:test>
    
    <!-- create account -->
    <t:property name="test_account1.name" value="test.${TIME}.${COUNTER}@${defaultdomain.name}"/>

    <t:test >
        <t:request>
            <CreateAccountRequest xmlns="urn:zimbraAdmin">
                <name>${test_account1.name}</name>
                <password>${defaultpassword.value}</password>
            </CreateAccountRequest>
        </t:request>
        <t:response>
            <t:select path="//admin:CreateAccountResponse/admin:account" attr="id"  set="test_account1.id"/>
            <t:select path='//admin:CreateAccountResponse/admin:account/admin:a[@n="zimbraMailHost"]' set="test_account1.server"/>
        </t:response>
    </t:test>
    
    <!-- Get mailbox for created account-->
    <t:test>
        <t:request>
            <GetMailboxRequest xmlns="urn:zimbraAdmin">
                <mbox id="${test_account1.id}"/>
            </GetMailboxRequest>
        </t:request>
        <t:response>
            <t:select path="//admin:GetMailboxResponse/admin:mbox"/>
        </t:response>
    </t:test>
    
    <!-- Run HSM to move existing mails those are matching with the policy -->
    <t:test >
		<t:request id="HsmSession01" depends="GetHsmStatus01" >
			<HsmRequest xmlns="urn:zimbraAdmin"/>
		</t:request>
        <t:response>
            <t:select path="//admin:HsmResponse"/>
        </t:response>
	</t:test>
	
	<t:for start="1" end="300" break="response1">
	
		<t:delay msec="1000"/>
	
		<t:test id="GetHsmStatus01" depends="HsmSession01" required="true">
			<t:request>
				<GetHsmStatusRequest xmlns="urn:zimbraAdmin"/>
			</t:request>
			<t:response>
				 <t:select path="//admin:GetHsmStatusResponse[@running='0']" query="response1">
					 <!-- totalMailboxes should be crtMailboxes + 1 -->
					 <t:select attr="totalMailboxes" match="${crtMailboxes}" emptyset="1"/>
					 <t:select attr="totalMailboxes" set="expected"/>
				 </t:select>
			</t:response>
		</t:test>
	
	</t:for>

    <!-- inject 3 old messages (3 blobs) -->
    <t:mailinjecttest >
        <t:lmtpInjectRequest>
		<foldername>${messages.dir}</foldername>
		<to>${test_account1.name}</to>
		<from>${nonZimbraUser.name}</from>
		<server>${test_account1.server}</server>
        </t:lmtpInjectRequest>
    </t:mailinjecttest>
    
    <t:property name="server.zimbraAccount" value="${test_account1.server}"/>
	
	<!-- Login to the account -->
	<t:test >
		<t:request>
	  		<AuthRequest xmlns="urn:zimbraAccount">
	    		<account by="name">${test_account1.name}</account>
			    <password>${defaultpassword.value}</password>
		    </AuthRequest>
		</t:request>
	  	<t:response>
			<t:select path="//acct:AuthResponse/acct:authToken" set="authToken"/>
		</t:response>
	</t:test>
    
    <!-- Search for the email -->
	<t:test id="SearchRequest">
		<t:request>
			<SearchRequest xmlns="urn:zimbraMail" types="message">
				<query>subject:email02A</query>
			</SearchRequest>
		</t:request>
		<t:response>
			<t:select path="//mail:SearchResponse/mail:m" attr="id" set="msg01.id"/>
		</t:response>
	</t:test>

	<!-- Do a get message to see if things are getting displayed properly-->
    <t:test id="GetMsgRequest" depends="SearchRequest">
        <t:request>
            <GetMsgRequest xmlns="urn:zimbraMail">
                <m id="${msg01.id}"/>
            </GetMsgRequest>
        </t:request>
       <t:response>
				<t:select path="//mail:GetMsgResponse/mail:m/mail:mp">
					<t:select attr="content" contains="${messages.content}" />
				</t:select>
			</t:response>
    </t:test>
    
    <t:property name="server.zimbraAdmin" value="${zimbraServer.name}"/> 
    
    <!-- Login to Admin account and run HSM session -->
    <t:test id="Login01" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>
    		
    <t:test>
		<t:request id="HsmSession01" depends="GetHsmStatus01" >
			<HsmRequest xmlns="urn:zimbraAdmin"/>
		</t:request>
        <t:response>
			<t:select path="//admin:HsmResponse"/>
        </t:response>
	</t:test>

	<t:for start="1" end="300" break="response2">
	
		<t:delay msec="1000"/>
		<!-- Get HSM status and verify number of blobs moved to secondary volume -->	
		<t:test id="GetHsmStatus01" depends="HsmSession01" required="true">
			<t:request>
				<GetHsmStatusRequest xmlns="urn:zimbraAdmin"/>
			</t:request>
			<t:response>
				 <t:select path="//admin:GetHsmStatusResponse[@running='0']" query="response2">
             		<t:select attr="totalMailboxes" match="${expected}"/>
					<t:select path="//admin:GetHsmStatusResponse" attr="numBlobsMoved" match="3"/>
				 </t:select>
			</t:response>
		</t:test>
	
	</t:for>
    
	<t:test >
		<t:request>
			<GetHsmStatusRequest xmlns="urn:zimbraAdmin"/>
		</t:request>
		<t:response>
			 <t:select path="//admin:GetHsmStatusResponse">
         		<t:select attr="totalMailboxes" match="${expected}"/>
				<t:select path="//admin:GetHsmStatusResponse" attr="numBlobsMoved" match="3"/>
			 </t:select>
		</t:response>
	</t:test>
	
	 <t:property name="server.zimbraAccount" value="${test_account1.server}"/>
	
	<!-- Login to the account -->
	<t:test >
		<t:request>
	  		<AuthRequest xmlns="urn:zimbraAccount">
	    		<account by="name">${test_account1.name}</account>
			    <password>${defaultpassword.value}</password>
		    </AuthRequest>
		</t:request>
	  	<t:response>
			<t:select path="//acct:AuthResponse/acct:authToken" set="authToken"/>
		</t:response>
	</t:test>
	
	<!-- Search for the email -->
	<t:test id="SearchRequest">
		<t:request>
			<SearchRequest xmlns="urn:zimbraMail" types="message">
				<query>subject:email02A</query>
			</SearchRequest>
		</t:request>
		<t:response>
			<t:select path="//mail:SearchResponse/mail:m" attr="id" set="msg01.id"/>
		</t:response>
	</t:test>

	<!-- Verify mails are getting displayed properly after getting moved to secondary volume -->
    <t:test id="GetMsgRequest" depends="SearchRequest">
        <t:request>
            <GetMsgRequest xmlns="urn:zimbraMail">
                <m id="${msg01.id}"/>
            </GetMsgRequest>
        </t:request>
        <t:response>
				<t:select path="//mail:GetMsgResponse/mail:m/mail:mp">
					<t:select attr="content" contains="${messages.content}" />
				</t:select>
			</t:response>
    </t:test>
	
</t:test_case>

</t:tests>
