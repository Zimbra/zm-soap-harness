<t:test_case testcaseid="Ping" type="always">
		<t:objective>basic system check</t:objective>

		<t:test required="true">
			<t:request>
				<PingRequest xmlns="urn:zimbraAdmin" />
			</t:request>
			<t:response>
				<t:select path="//admin:PingResponse" />
			</t:response>
		</t:test>
</t:test_case>

<t:test_case testcaseid="CreateVolumeRequest_01" type="sanity" areas="StorageManagement">
		<t:objective>Verify user should be able to create primary volume of OpenIO storage provider</t:objective>
		<t:steps>
			1. Login as the Admin
			2. Create a valid primary volume of Storage Type = OpenIO
			3. Verify volume details by GetVolumeRequest
			4. Verify volume ID is returning in GetAllVolumesRequest
		</t:steps>

		<t:test id="Login01" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>

		<t:test id="CreateVolume01" depends="Login01" required="true">
			<t:request>
				  <CreateVolumeRequest xmlns="urn:zimbraAdmin">
        				 <volume name="${name1}" type="${type_primary}" storeType="${storeType_external}">
        				 <volumeExternalInfo storageType="${storageType}"/>
          			  			<volumeExternalOpenIoInfo storageType="${storageType}" url="${SM.OPENIO.URL}" account="${SM.OPENIO.ACCOUNT}" nameSpace="${SM.OPENIO.NAMESPACE}" proxyPort="${SM.OPENIO.PROXY.PORT}" accountPort="${SM.OPENIO.ACCOUNT.PORT}" />
         				</volume>
    			  </CreateVolumeRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="id" set="volume1.id" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="name" match="${name1}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="type" match="${type_primary}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="storeType" match="${storeType_external}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="storageType" match="${storageType}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="url" match="${SM.OPENIO.URL}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="account" match="${SM.OPENIO.ACCOUNT}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="nameSpace" match="${SM.OPENIO.NAMESPACE}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="proxyPort" match="${SM.OPENIO.PROXY.PORT}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="accountPort" match="${SM.OPENIO.ACCOUNT.PORT}" />
			</t:response>
		</t:test>
		
		<!-- Get the volume just created. -->
		<t:test depends="CreateVolume01">
			<t:request>
				<GetVolumeRequest xmlns="urn:zimbraAdmin" id="${volume1.id}" />
			</t:request>
			<t:response>
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="id" match="${volume1.id}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="name" match="${name1}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="type" match="${type_primary}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="storageType" match="${storageType}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="url" match="${SM.OPENIO.URL}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="account" match="${SM.OPENIO.ACCOUNT}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="nameSpace" match="${SM.OPENIO.NAMESPACE}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="proxyPort" match="${SM.OPENIO.PROXY.PORT}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalOpenIoInfo" attr="accountPort" match="${SM.OPENIO.ACCOUNT.PORT}" />
			</t:response>
		</t:test>
		
		<!-- Show all currently defined volumes. The new volume should be present. -->
		<t:test depends="CreateVolume01">
			<t:request>
				<GetAllVolumesRequest xmlns="urn:zimbraAdmin" />
			</t:request>
			<t:response>
				<t:select path="//admin:GetAllVolumesResponse/admin:volume" attr="id" match="${volume1.id}" />	
			</t:response>
		</t:test>
		
</t:test_case>

