<t:test_case testcaseid="Ping" type="always">
		<t:objective>basic system check</t:objective>

		<t:test required="true">
			<t:request>
				<PingRequest xmlns="urn:zimbraAdmin" />
			</t:request>
			<t:response>
				<t:select path="//admin:PingResponse" />
			</t:response>
		</t:test>
</t:test_case>

<t:test_case testcaseid="Configure_bucket" type="always">
		<t:objective>Configure bucket for creating volumes</t:objective>

		<t:test id="Login01" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>
		
		<t:test id="CreateS3Buckets" required="true">
			<t:request>
				<CreateS3BucketConfigRequest xmlns="urn:zimbraAdmin">
					 <a n="bucketName">${SM.AWS.BUCKET.NAME}</a>
        			 <a n="storeProvider">${storageType_AWS_S3}</a>
       			     <a n="secretKey">${SM.AWS.SECRET.KEY}</a>
        			 <a n="accessKey">${SM.AWS.ACCESS.KEY}</a>
        			 <a n="protocol">HTTPS</a>
                     <a n="region">${SM.AWS.REGION}</a>
                     <a n="url">${SM.AWS.BASE.URI}</a>
                     <a n="destinationPath">${destinationPath}</a>
	 			</CreateS3BucketConfigRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='globalBucketUUID']" set="aws.globalBucketUUID" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketName']" match="${SM.AWS.BUCKET.NAME}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='storeProvider']" match="${storageType_AWS_S3}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='accessKey']" match="${SM.AWS.ACCESS.KEY}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketStatus']" match="ACTIVE" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='region']" match="${SM.AWS.REGION}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='url']" match="${SM.AWS.BASE.URI}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='destinationPath']" match="${destinationPath}" /> 
			</t:response>
		</t:test>
		
		 <t:test id="CreateS3Bucket_CEPH" required="true">
			<t:request>
				<CreateS3BucketConfigRequest xmlns="urn:zimbraAdmin">
					 <a n="storeProvider">${storageType_CEPH_S3}</a>
					 <a n="bucketName">${SM.CEPH.BUCKET.NAME}</a>
        			 <a n="storeProvider">${storageType_CEPH_S3}</a>
       			     <a n="secretKey">${SM.CEPH.SECRET.KEY}</a>
        			 <a n="accessKey">${SM.CEPH.ACCESS.KEY}</a>
                     <a n="url">${SM.CEPH.BASE.URI}</a>
                     <a n="destinationPath">${destinationPathCeph}</a>
	 			</CreateS3BucketConfigRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='globalBucketUUID']" set="CEPH.globalBucketUUID" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketName']" match="${SM.CEPH.BUCKET.NAME}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='storeProvider']" match="${storageType_CEPH_S3}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='accessKey']" match="${SM.CEPH.ACCESS.KEY}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='bucketStatus']" match="${bucketStatus}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='url']" match="${SM.CEPH.BASE.URI}" />
				<t:select path="//admin:CreateS3BucketConfigResponse/admin:a[@n='destinationPath']" match="${destinationPathCeph}" />
			</t:response>
		</t:test>
		
			<t:test id="CreateS3Bucket_Storage_Grid" required="true">
			<t:request>
				<CreateS3BucketConfigRequest xmlns="urn:zimbraAdmin">
					 <a n="bucketName">${SM.NetApp.BUCKET.NAME}</a>
        			 <a n="storeProvider">${storageType_NetApp_S3}</a>
       			     <a n="secretKey">${SM.NetApp.SECRET.KEY}</a>
        			 <a n="accessKey">${SM.NetApp.ACCESS.KEY}</a>
                     <a n="url">${SM.NetApp.BASE.URI}</a>
                     <a n="protocol">HTTPS</a>
                     <a n="destinationPath">${destinationPath}</a>
                     <a n="region">${SM.AWS.REGION}</a>
	 			</CreateS3BucketConfigRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateS3BucketConfigResponse//admin:a[@n='globalBucketUUID']" set="NetApp.globalBucketUUID" />
				<t:select path="//admin:CreateS3BucketConfigResponse//admin:a[@n='bucketName']" match="${SM.NetApp.BUCKET.NAME}" />
				<t:select path="//admin:CreateS3BucketConfigResponse//admin:a[@n='storeProvider']" match="${storageType_NetApp_S3}" />
				<t:select path="//admin:CreateS3BucketConfigResponse//admin:a[@n='accessKey']" match="${SM.NetApp.ACCESS.KEY}" />
				<t:select path="//admin:CreateS3BucketConfigResponse//admin:a[@n='bucketStatus']" match="${bucketStatus}" />
				<t:select
    path="//admin:CreateS3BucketConfigResponse//admin:a[@n='url']"
    matchtext="${SM.NetApp.BASE.URI}" />
				<t:select path="//admin:CreateS3BucketConfigResponse//admin:a[@n='destinationPath']" match="${destinationPath}" />
			</t:response>
		</t:test>

		<t:test id="GetServerId" required="true"> 
			<t:request>
				<GetServerRequest xmlns="urn:zimbraAdmin">
					<server by="name">${zimbraServer.name}</server>
				</GetServerRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:GetServerResponse/admin:server" attr="id" set="server.id"/>
			</t:response>
		</t:test>	
		
</t:test_case>

<t:test_case testcaseid="ModifyVolumeRequest_01" type="bhr" areas="StorageManagement">
		<t:objective>Verify user should be able to modify primary volume of S3 storage provider</t:objective>
		<t:steps>
			1. Login as the Admin
			2. Create a valid primary volume of Storage Type = S3
			3. Verify volume details by GetVolumeRequest
			4. Modify created volume and validate parameters are getting modified as per the inputs
		</t:steps>

		<t:test id="Login01" required="true">
			<t:request>
				<AuthRequest xmlns="urn:zimbraAdmin">
					<name>${admin.user}</name>
					<password>${admin.password}</password>
				</AuthRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
			</t:response>
		</t:test>

		<t:test id="CreateVolume01" depends="Login01" required="true">
			<t:request>
				<CreateVolumeRequest xmlns="urn:zimbraAdmin">
					<volume type="${type_primary}" name="${name1}" storeType="${storeType_external}">
						<volumeExternalInfo storageType="${storageType}" volumePrefix="${volumePrefix}" globalBucketConfigId="${aws.globalBucketUUID}" useInFrequentAccess="${useInFrequentAccess}" useInFrequentAccessThreshold="${useInFrequentAccessThreshold}" useIntelligentTiering="${useIntelligentTiering}" />
					</volume>
				</CreateVolumeRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="id" set="volume1.id" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="name" match="${name1}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume" attr="type" match="${type_primary}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="storageType" match="${storageType}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="volumePrefix" match="${volumePrefix}-${server.id}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="globalBucketConfigId" match="${aws.globalBucketUUID}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useInFrequentAccess" match="${useInFrequentAccess}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useInFrequentAccessThreshold" match="${useInFrequentAccessThreshold}" />
				<t:select path="//admin:CreateVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useIntelligentTiering" match="${useIntelligentTiering}" />
			</t:response>
		</t:test>

		<!-- Get the volume just created. -->
		<t:test depends="CreateVolume01">
			<t:request>
				<GetVolumeRequest xmlns="urn:zimbraAdmin" id="${volume1.id}" />
			</t:request>
			<t:response>
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="id" match="${volume1.id}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="name" match="${name1}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="type" match="${type_primary}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="storageType" match="${storageType}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="volumePrefix" match="${volumePrefix}-${server.id}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="globalBucketConfigId" match="${aws.globalBucketUUID}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useInFrequentAccess" match="${useInFrequentAccess}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useInFrequentAccessThreshold" match="${useInFrequentAccessThreshold}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useIntelligentTiering" match="${useIntelligentTiering}" />
			</t:response>
		</t:test>

		<!-- Get the volume just created. -->
		<t:test depends="CreateVolume01">
			<t:request>
				<ModifyVolumeRequest xmlns="urn:zimbraAdmin" id="${volume1.id}"> 
					<volume name="${name1_updated}"/>
				</ModifyVolumeRequest>
			</t:request>
			<t:response>
				<t:select path="//admin:ModifyVolumeResponse" />
			</t:response>
		</t:test>
		
		<!-- Get the volume just modified. -->
		<t:test depends="CreateVolume01">
			<t:request>
				<GetVolumeRequest xmlns="urn:zimbraAdmin" id="${volume1.id}" />
			</t:request>
			<t:response>
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="id" match="${volume1.id}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="name" match="${name1_updated}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume" attr="type" match="${type_primary}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="storageType" match="${storageType}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="volumePrefix" match="${volumePrefix}-${server.id}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="globalBucketConfigId" match="${aws.globalBucketUUID}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useInFrequentAccess" match="${useInFrequentAccess}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useInFrequentAccessThreshold" match="${useInFrequentAccessThreshold}" />
				<t:select path="//admin:GetVolumeResponse/admin:volume/admin:volumeExternalInfo" attr="useIntelligentTiering" match="${useIntelligentTiering}" />
			</t:response>
		</t:test>
</t:test_case>

