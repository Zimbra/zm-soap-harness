    <t:test_case testcaseid="CreateAddressList_04" type="bhr"
        bugids="ZCS-5847,ZCS-6075">
        <t:objective>Create a new address list with basic parameters
        </t:objective>
        <t:steps>
            1. Create a new address list with search filter to bring
            bring all members
            from ldap whose jobTitle has manager or
            those whose work country
            is equal to India
            2. fire GetLDAPEntriesRequest to verify the gal and ldap
            queries have proper values.
        </t:steps>
        <t:property name="addressList4_name" value="addressList4_${TIME}" />
        <t:property name="country" value="India" />
        <t:test>
            <t:request>
                <CreateAddressListRequest type="account"
                    xmlns="urn:zimbraAdmin">
                    <name>${addressList4_name}</name>
                    <searchFilter>
                        <conds not="false" or="1">
                            <cond not="0" attr="jobTitle" op="has" value="${manager}" />
                            <cond not="0" attr="workCountry" op="eq" value="${country}" />
                        </conds>
                    </searchFilter>
                    <domain by="name">${defaultdomain.name}</domain>
                </CreateAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAddressListResponse" attr="id" set ="addressList4_id"/>
            </t:response>
        </t:test>        
        <t:test>
            <t:request>
                <GetLDAPEntriesRequest xmlns="urn:zimbraAdmin">
                    <ldapSearchBase>dc=com</ldapSearchBase>
                    <query>uid=${addressList4_name}*</query>
                </GetLDAPEntriesRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='objectClass']"
                    contains="zimbraAddressList" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="((#jobTitle:(*${manager}*) OR #workCountry:(${country})))" />
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="!(#zimbraAccountCalendarUserType:RESOURCE)"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(|(title=*${manager}*)(co=${country})))"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="!(zimbraIsSystemResource=TRUE)"/>    
            </t:response>
        </t:test>
         <t:test>
           <t:request>
            <GetAddressListInfoRequest id="${addressList4_id}"
             xmlns="urn:zimbraAdmin">
            </GetAddressListInfoRequest>
           </t:request>
           <t:response>
           <t:select path="//admin:GetAddressListInfoResponse" attr="name"  contains="${addressList4_name}" />
           <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds" attr="not" match="0" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[1]" attr="op" match="has" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[1]" attr="not" match="0" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[1]" attr="attr" match="jobTitle" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[1]" attr="value" match="${manager}" />
             <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[2]" attr="op" match="eq" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[2]" attr="not" match="0" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[2]" attr="attr" match="workCountry" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[2]" attr="value" match="${country}" />
           </t:response>
          </t:test>
    </t:test_case>

