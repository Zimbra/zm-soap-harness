    <t:test_case testcaseid="CreateAddressList_06" type="bhr"
        bugids="ZCS-5847,ZCS-6075">
        <t:objective>Create a new address list for resource type</t:objective>
        <t:steps>
            1. Create a new address list with search filter set for
            fetching resources whose resType is location and displayName
            starts with Pune.
            2. fire GetLDAPEntriesRequest to verify the gal and ldap
            queries have proper values.
        </t:steps>
        <t:property name="addressList6_name" value="addressList6_${TIME}" />
        <t:property name="locationName" value="Pune" />
        <t:test>
            <t:request>
                <CreateAddressListRequest type="resource"
                    xmlns="urn:zimbraAdmin">
                    <name>${addressList6_name}</name>
                    <searchFilter>
                        <conds not="0" or="0">
                            <cond attr="zimbraCalResType" op="eq" value="location" />
                            <cond attr="zimbraCalResLocationDisplayName" op="startswith" value="${locationName}" />
                        </conds>
                    </searchFilter>
                    <domain by="name">${defaultdomain.name}</domain>
                </CreateAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAddressListResponse"  attr="id" set="addressList6_id" />
            </t:response>
        </t:test>        
        <t:test>
            <t:request>
                <GetLDAPEntriesRequest xmlns="urn:zimbraAdmin">
                    <ldapSearchBase>dc=com</ldapSearchBase>
                    <query>uid=${addressList6_name}*</query>
                </GetLDAPEntriesRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='objectClass']"
                    contains="zimbraAddressList" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="((#zimbraCalResType:(location) AND #zimbraCalResLocationDisplayName:(${locationName}*))) AND #zimbraAccountCalendarUserType:RESOURCE" />
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="!(#zimbraAccountCalendarUserType:RESOURCE)" emptyset="1"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(&amp;(zimbraCalResType=location)(zimbraCalResLocationDisplayName=${locationName}*)))"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(objectclass=zimbraCalendarResource)"/>    
            </t:response>
        </t:test>
        <t:test>
           <t:request>
            <GetAddressListInfoRequest id="${addressList6_id}"
             xmlns="urn:zimbraAdmin">
            </GetAddressListInfoRequest>
           </t:request>
           <t:response>
           <t:select path="//admin:GetAddressListInfoResponse" attr="name"  contains="${addressList6_name}" />
           <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds" attr="not" match="0" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[1]" attr="op" match="eq" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[1]" attr="attr" match="zimbraCalResType" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[1]" attr="value" match="location" />
             <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[2]" attr="op" match="startswith" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[2]" attr="attr" match="zimbraCalResLocationDisplayName" />
            <t:select path="//admin:GetAddressListInfoResponse/admin:searchFilter/admin:conds/admin:cond[2]" attr="value" match="${locationName}" />
           </t:response>
          </t:test>
    </t:test_case>

