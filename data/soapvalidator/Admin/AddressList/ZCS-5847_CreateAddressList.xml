        <t:objective>Create a new address list for all members whose (workPostalCode 
        is  equal to 85001 and workCity is equal to Phoenix) or (workState is Arizona)</t:objective>
        <t:steps>
            1. Create a new address list with search filter set for
            fetching all members
            whose (workPostalCode 
            is  equal to 85001 and workCity is equal to Phoenix) or (workState is Arizona)
            2. Fire GetLDAPEntriesRequest to verify the filter query created for ldap and gal
        </t:steps>
        <t:property name="addressList9_name" value="addressList9_${TIME}" />
        <t:test>
            <t:request>
                <CreateAddressListRequest xmlns="urn:zimbraAdmin">
                    <name>${addressList9_name}</name>
                    <searchFilter>
                        <conds not="0" or="1">
                            <conds not="0" or="0">
                                <cond attr="workPostalCode" op="eq" value="${postal_code}" />
                                <cond attr="workCity" op="eq" value="${city}" />
                            </conds>
                            <cond not="0" attr="workState" op="eq" value="${state}" />
                        </conds>
                    </searchFilter>
                    <domain by="name">${defaultdomain.name}</domain>
                </CreateAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAddressListResponse" attr="id" set ="addressList9_id"/>
            </t:response>
        </t:test>        
        <t:test>
            <t:request>
                <GetLDAPEntriesRequest xmlns="urn:zimbraAdmin">
                    <ldapSearchBase>dc=com</ldapSearchBase>
                    <query>uid=${addressList9_name}*</query>
                </GetLDAPEntriesRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='objectClass']"
                    contains="zimbraAddressList" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="(((#workPostalCode:(${postal_code}) AND #workCity:(${city})) OR #workState:(${state})))" />
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="!(#zimbraAccountCalendarUserType:RESOURCE)" emptyset="1"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(|(&amp;(postalCode=${postal_code})(l=${city}))(st=${state}))"/>    
            </t:response>
        </t:test>
