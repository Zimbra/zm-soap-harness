<t:tests xmlns:t="urn:zimbraTestHarness">
    <t:property name="acct1.name"
        value="test1_${TIME}.${COUNTER}@${defaultdomain.name}" />

    <t:test_case testcaseid="Ping" type="always">
        <t:objective>basic system check</t:objective>
        <t:test required="true">
            <t:request>
                <PingRequest xmlns="urn:zimbraAdmin" />
            </t:request>
            <t:response>
                <t:select path="//admin:PingResponse" />
            </t:response>
        </t:test>
    </t:test_case>

    <t:test_case testcaseid="CreateAccounts" type="always">
        <t:objective>Account Setup </t:objective>
        <t:steps>
            1. Login into admin.
            2. Create test accounts.
        </t:steps>
        <t:test id="admin_login" required="true">
            <t:request>
                <AuthRequest xmlns="urn:zimbraAdmin">
                    <name>${admin.user}</name>
                    <password>${admin.password}</password>
                </AuthRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:AuthResponse/admin:authToken" set="authToken" />
            </t:response>
        </t:test>    
        <t:property name="domain1.name" value="domain1${COUNTER}.${TIME}.com"/>        
        <t:test required="true">
            <t:request>
                <CreateDomainRequest xmlns="urn:zimbraAdmin">
                    <name>${domain1.name}</name>
                </CreateDomainRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateDomainResponse"/>
            </t:response>
        </t:test>
        <t:test required="true">
            <t:request>
                <CreateAccountRequest xmlns="urn:zimbraAdmin">
                    <name>${acct1.name}</name>
                    <password>${defaultpassword.value}</password>
                </CreateAccountRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAccountResponse/admin:account"
                    attr="id" set="account1.id" />
            </t:response>
        </t:test>        
        <t:test>
            <t:request>
                <ModifyConfigRequest  xmlns="urn:zimbraAdmin">
                    <a n="+zimbraGalLdapFilterDef">department_eq:(ou=%s)</a>
                    <a n="+zimbraGalLdapFilterDef">jobTitle_eq:(title=%s)</a>
                    <a n="+zimbraGalLdapFilterDef">workCountry_eq:(co=%s)</a>
                    <a n="+zimbraGalLdapFilterDef">jobTitle_has:(title=*%s*)</a>
                    <a n="+zimbraGalLdapFilterDef">zimbraCalResType_eq:(zimbraCalResType=%s)</a>
                    <a n="+zimbraGalLdapFilterDef">zimbraCalResLocationDisplayName_startswith:(zimbraCalResLocationDisplayName=%s*)</a>
                    <a n="+zimbraGalLdapFilterDef">workState_eq:(st=%s)</a>
                    <a n="+zimbraGalLdapFilterDef">workCity_eq:(l=%s)</a>
                    <a n="+zimbraGalLdapFilterDef">workPostalCode_eq:(postalCode=%s)</a>
                    <a n="+zimbraGalLdapFilterDef">notes_has:(description=*%s*)</a>
                </ModifyConfigRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:ModifyConfigResponse"/>
            </t:response>
        </t:test>
    </t:test_case>

    <t:test_case testcaseid="ModifyAddressList_01" type="bhr"
        bugids="ZCS-5388">
        <t:objective>Modify an existing address list and verify it's properties
        </t:objective>
        <t:steps>
            1. Create a new address list with description and search
            filter for accounts having department as QA.
            2. Fire GetLDAPEntriesRequest to verify the gal and ldap
            queries have proper values.
            3. Modify the above address list and change the name.
            4. Verify the name is changed for the addresslist.
        </t:steps>
        <t:property name="addressList1_name" value="addressList1_${TIME}" />
        <t:property name="qa_dept" value="QA" />
        <t:property name="description" value="Test address list" />
        <t:test>
            <t:request>
                <CreateAddressListRequest type="all"
                    xmlns="urn:zimbraAdmin">
                    <name>${addressList1_name}</name>
                    <desc>${description}</desc>
                    <searchFilter>
                        <conds or="1">
                            <cond attr="department" op="eq" value="${qa_dept}" />
                        </conds>
                    </searchFilter>
                    <domain by="name">${defaultdomain.name}</domain>
                </CreateAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAddressListResponse//admin:id"
                    set="addressList1.id" />
            </t:response>
        </t:test>
        <t:test>
            <t:request>
                <GetLDAPEntriesRequest xmlns="urn:zimbraAdmin">
                    <ldapSearchBase>dc=com</ldapSearchBase>
                    <query>uid=${addressList1_name}*</query>
                </GetLDAPEntriesRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='objectClass']"
                    contains="zimbraAddressList" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='description']"
                    contains="${description}" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="((#department:(QA)))" />
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="zimbraAccountCalendarUserType:RESOURCE" emptyset="1"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(ou=QA))"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="!(zimbraIsSystemResource=TRUE)"/>    
            </t:response>
        </t:test>
         <t:property name="modified_addressList1_name" value="modaddressList1_${TIME}" />
        <t:test>
            <t:request>
                <ModifyAddressListRequest type="all" id="${addressList1.id}" xmlns="urn:zimbraAdmin">
                     <name>${modified_addressList1_name}</name>
                     <desc>${description}</desc>
                     <searchFilter>
                        <conds or="1">
                            <cond attr="department" op="eq" value="${qa_dept}" />
                        </conds>
                    </searchFilter>
                </ModifyAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:ModifyAddressListResponse" />
            </t:response>
        </t:test>
        <t:test>
            <t:request>
                <GetLDAPEntriesRequest xmlns="urn:zimbraAdmin">
                    <ldapSearchBase>dc=com</ldapSearchBase>
                    <query>uid=${modified_addressList1_name}*</query>
                </GetLDAPEntriesRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='objectClass']"
                    contains="zimbraAddressList" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='description']"
                    contains="${description}" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="((#department:(QA)))" />
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="zimbraAccountCalendarUserType:RESOURCE" emptyset="1"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(ou=QA))"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="!(zimbraIsSystemResource=TRUE)"/>
            </t:response>
        </t:test>
    </t:test_case>
    
    <t:test_case testcaseid="ModifyAddressList_02" type="bhr"
        bugids="ZCS-5388">
        <t:objective>Modify an existing address list search filter and verify it's properties
        </t:objective>
        <t:steps>
            1. Create a new address list with description and search
            filter for accounts having department as QA.
            2. Fire GetLDAPEntriesRequest to verify the gal and ldap
            queries have proper values.
            3. Modify the above address list and change the search filter. Keep clearFilter=true
            so that this attribute should be ignored if searchFilter is present.
            4. Verify the search filter is changed for the addresslist in ldap and gal.
        </t:steps>
        <t:property name="addressList2_name" value="addressList2_${TIME}" />
        <t:property name="qa_dept" value="QA" />
        <t:property name="manager" value="Manager" />
        <t:property name="description" value="Test address list" />
        <t:test>
            <t:request>
                <CreateAddressListRequest type="all"
                    xmlns="urn:zimbraAdmin">
                    <name>${addressList2_name}</name>
                    <desc>${description}</desc>
                    <searchFilter>
                        <conds or="1">
                            <cond attr="department" op="eq" value="${qa_dept}" />
                        </conds>
                    </searchFilter>
                    <domain by="name">${defaultdomain.name}</domain>
                </CreateAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:CreateAddressListResponse//admin:id"
                    set="addressList2.id" />
            </t:response>
        </t:test>        
        <t:test>
            <t:request>
                <GetLDAPEntriesRequest xmlns="urn:zimbraAdmin">
                    <ldapSearchBase>dc=com</ldapSearchBase>
                    <query>uid=${addressList2_name}*</query>
                </GetLDAPEntriesRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='objectClass']"
                    contains="zimbraAddressList" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='description']"
                    contains="${description}" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="((#department:(QA)))" />
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="zimbraAccountCalendarUserType:RESOURCE" emptyset="1"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(ou=QA))"/>
                <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="!(zimbraIsSystemResource=TRUE)"/>    
            </t:response>
        </t:test>
        <t:test>
            <t:request>
                <ModifyAddressListRequest type="all" id="${addressList2.id}" clearFilter="false" xmlns="urn:zimbraAdmin">
                     <name>${addressList2_name}</name>
                     <desc>${description}</desc>
                     <searchFilter>
                        <conds not="false" or="1">
                            <cond not="false" attr="jobTitle" op="eq" value="${manager}" />
                        </conds>
                    </searchFilter>
                </ModifyAddressListRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:ModifyAddressListResponse" />
            </t:response>
        </t:test>
        <t:test>
            <t:request>
                <GetLDAPEntriesRequest xmlns="urn:zimbraAdmin">
                    <ldapSearchBase>dc=com</ldapSearchBase>
                    <query>uid=${addressList2_name}*</query>
                </GetLDAPEntriesRequest>
            </t:request>
            <t:response>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='objectClass']"
                    contains="zimbraAddressList" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='description']"
                    contains="${description}" />
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListLdapFilter']"
                    contains="(title=Manager))"/>
               <t:select path="//admin:GetLDAPEntriesResponse//admin:a[@n='zimbraAddressListGalFilter']"
                    contains="((#jobTitle:(Manager)))" />
            </t:response>
        </t:test>
    </t:test_case>
    
