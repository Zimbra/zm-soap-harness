    <t:test_case testcaseid="ModifyAddressList_04" type="bhr"
        bugids="ZCS-5388">
        <t:objective>Modify an existing address list and keep id as invalid
        </t:objective>
        <t:steps>
            1. Modify the above address list and keep id as invalid.
            2. Verify the response should be error.
        </t:steps>       
        <t:property name="mod_addressList3_name" value="mod_addressList3_${TIME}" />
        <t:test>
            <t:request>
                <ModifyAddressListRequest type="all" id="invalid-id" xmlns="urn:zimbraAdmin">
                     <name>${addressList3_name}</name>
                     <desc>${description}</desc>
                     <searchFilter>
                        <conds not="false" or="1">
                            <cond not="false" attr="jobTitle" op="eq" value="${manager}" />
                        </conds>
                    </searchFilter>
                </ModifyAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//zimbra:Code" match="^account.NO_SUCH_ADDRESS_LIST" />
            </t:response>
        </t:test>
    </t:test_case>
    
