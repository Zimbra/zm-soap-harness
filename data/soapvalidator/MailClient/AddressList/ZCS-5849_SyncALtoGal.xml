<t:test_case testcaseid="SyncAddressListToGal_04" type="sanity" bugids="ZCS-5388">
    <t:objective>Modify the address list and verify it gets synced to gal</t:objective>
    <t:steps>
        1. Modify the existing address list 3,
        2. Send SearchGalRequest for modified address list3 on basis of name
    </t:steps>
       <t:property name="mod_addressList3_name" value="mod_addressList3_${TIME}" />
        <t:property name="qa_dept" value="QA" />
        <t:property name="manager" value="Managert" />
        <t:test>
            <t:request>
                <AuthRequest xmlns="urn:zimbraAdmin">
                    <name>${admin.user}</name>
                    <password>${admin.password}</password>
                </AuthRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:AuthResponse/admin:authToken" set="authToken"/>
            </t:response>
        </t:test>
        <t:test>
            <t:request>
                <ModifyAddressListRequest type="all" id="${addressList3.id}" xmlns="urn:zimbraAdmin">
                     <name>${mod_addressList3_name}</name>
                     <desc>${description}</desc>
                     <searchFilter>
                        <conds not="false" or="1">
                            <cond not="false" attr="jobTitle" op="eq" value="${manager}" />
                        </conds>
                    </searchFilter>
                </ModifyAddressListRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:ModifyAddressListResponse" />
            </t:response>
        </t:test>
        <t:test>
            <t:request>
                <SyncGalAccountRequest xmlns="urn:zimbraAdmin" >
                    <account id="${domain1.galaccount.id}">
                        <datasource by="name" fullSync="true" reset="true">${domain1.galaccount.datasource.name}</datasource>
                    </account>
                </SyncGalAccountRequest>
            </t:request>
            <t:response>
                <t:select path="//admin:SyncGalAccountResponse"/>
            </t:response>
        </t:test>   
    <t:test>
        <t:request>
            <AuthRequest xmlns="urn:zimbraAccount">
                <account by="name">${domain1.account1.name}</account>
                <password>${defaultpassword.value}</password>
            </AuthRequest>
        </t:request>
        <t:response>
            <t:select path="//acct:AuthResponse/acct:authToken" set="authToken"/>
        </t:response>
    </t:test>   
    <t:delay sec="10" />
    <t:test>
        <t:request>
           <SearchGalRequest ref="uid=mod_addressList3*" xmlns="urn:zimbraAccount" name="" type="all">
                <searchFilter>
                    <conds>
                       <cond attr="objectClass" op="has" value="zimbraAddressList"/>
                    </conds>
                </searchFilter>
            </SearchGalRequest>
        </t:request>
        <t:response>
            <t:select path="//acct:SearchGalResponse//acct:a[@n='objectClass']" match="zimbraAddressList" />
            <t:select path="//acct:SearchGalResponse//acct:cn" attr="ref" contains="${mod_addressList3_name}" />
            <t:select path="//acct:SearchGalResponse//acct:cn" attr="ref" contains="${addressList1_name}" emptyset="1"/>    
        </t:response>
    </t:test>
</t:test_case>

</t:tests>
